---
import Layout from '../components/Layout.astro';
import { getSection } from '../lib/db/page-section';
import { getPengaturan } from '../lib/db/pengaturan';
import {
  filterPublicStatCats,
  getStatistikFull,
  parseDusunValue,
  parseSimpleValue,
  totalPendudukFromStats,
  type StatKategoriWithRows,
} from '../lib/db/statistik';
import { getEnv } from '@lib/env';

const env = getEnv();
const [umum, geografis, sejarah, s, statCatsRaw] = await Promise.all([
  env ? getSection('profil-umum', env.DB) : null,
  env ? getSection('profil-geografis', env.DB) : null,
  env ? getSection('profil-sejarah', env.DB) : null,
  env ? getPengaturan(env.DB) : {},
  env ? getStatistikFull(env.DB, true).catch(() => [] as StatKategoriWithRows[]) : Promise.resolve([] as StatKategoriWithRows[]),
]);

const fmt = (n: number) => n.toLocaleString('id-ID');
const barPct = (v: number, max: number) => Math.max(4, Math.round((v / max) * 100));

const stUmum = JSON.parse(s.stat_umum ?? '{}');

// Prefer new tables; fall back to legacy pengaturan JSON if empty.
let statCats = statCatsRaw;
if (statCats.length === 0) {
  const dusunData: { label: string; l: number; p: number; kk: number }[] = JSON.parse(s.stat_dusun ?? '[]');
  const umurData: { label: string; value: number }[] = JSON.parse(s.stat_umur ?? '[]');
  const pendidikanData: { label: string; value: number }[] = JSON.parse(s.stat_pendidikan ?? '[]');
  const pencaharianData: { label: string; value: number }[] = JSON.parse(s.stat_pencaharian ?? '[]');
  const now = '';
  statCats = [
    {
      id: 1, key: 'dusun', label: 'Penduduk per Dusun', layout: 'dusun', urutan: 10, aktif: 1, created_at: now, updated_at: now,
      rows: dusunData.map((d, i) => ({
        id: i, kategori_id: 1, label: d.label, value_json: JSON.stringify(d), urutan: i, created_at: now, updated_at: now,
      })),
    },
    {
      id: 2, key: 'umur', label: 'Golongan Umur', layout: 'simple', urutan: 20, aktif: 1, created_at: now, updated_at: now,
      rows: umurData.map((d, i) => ({
        id: i, kategori_id: 2, label: d.label, value_json: JSON.stringify({ value: d.value }), urutan: i, created_at: now, updated_at: now,
      })),
    },
    {
      id: 3, key: 'pendidikan', label: 'Tingkat Pendidikan', layout: 'simple', urutan: 30, aktif: 1, created_at: now, updated_at: now,
      rows: pendidikanData.map((d, i) => ({
        id: i, kategori_id: 3, label: d.label, value_json: JSON.stringify({ value: d.value }), urutan: i, created_at: now, updated_at: now,
      })),
    },
    {
      id: 4, key: 'pencaharian', label: 'Mata Pencaharian', layout: 'simple', urutan: 40, aktif: 1, created_at: now, updated_at: now,
      rows: pencaharianData.map((d, i) => ({
        id: i, kategori_id: 4, label: d.label, value_json: JSON.stringify({ value: d.value }), urutan: i, created_at: now, updated_at: now,
      })),
    },
  ];
}

statCats = filterPublicStatCats(statCats);
const fromDusunRows = totalPendudukFromStats(statCats);
const totalPenduduk = Number(stUmum.penduduk) || fromDusunRows || 0;
const dusunCat = statCats.find((c) => c.layout === 'dusun');
const jumlahDusun = Number(stUmum.dusun) || dusunCat?.rows.length || 4;
const mapLat = Number(s.map_lat) || -7.009933224557312;
const mapLng = Number(s.map_lng) || 106.58103748650889;
const mapZoom = Number(s.map_zoom) || 15;
const kecamatan = s.kecamatan || 'Palabuhanratu';
const kabupaten = s.kabupaten || 'Sukabumi';
---

<Layout
  title="Profil Desa | Desa Citarik"
  description="Profil lengkap Desa Citarik: kondisi geografis, demografi, dan gambaran desa di Kecamatan Palabuhanratu, Kabupaten Sukabumi (Prodeskel 2025)."
>

<section class="page-hero">
  <div class="page-hero__media">
    <img src="/images/pantai_Citarik.png" alt="Pantai dan alam Desa Citarik" />
  </div>
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content">
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Beranda</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <span class="font-medium text-white">Profil Desa</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold mt-1.5">Profil Desa Citarik</h1>
      <p class="text-white/85 mt-1.5 max-w-xl">Kecamatan Palabuhanratu, Kabupaten Sukabumi, Jawa Barat</p>
    </div>
  </div>
</section>

<div class="subnav">
  <div class="container-page py-2 flex gap-2 overflow-x-auto">
    {[
      ['#umum', 'Umum'],
      ['#geografis', 'Geografis'],
      ['#demografi', 'Demografi'],
      ['#sejarah', 'Sejarah'],
      ['#peta', 'Peta'],
      ['/pemerintahan', 'Pemerintahan ↗'],
    ].map(([href, label]) => (
      <a href={href} class="subnav-link">{label}</a>
    ))}
  </div>
</div>

<div class="container-page py-10 space-y-14">

  <!-- Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    {[
      { icon: 'users', label: 'Penduduk', value: fmt(totalPenduduk || Number(stUmum.penduduk) || 0), sub: 'Jiwa' },
      { icon: 'layers', label: 'Wilayah', value: stUmum.luas ?? '-', sub: 'Hektar' },
      { icon: 'home', label: 'Dusun', value: String(jumlahDusun), sub: 'Wilayah' },
      { icon: 'map-pin', label: 'RW / RT', value: `${stUmum.rw ?? '-'} / ${stUmum.rt ?? '-'}`, sub: 'Administratif' },
    ].map(tile => (
      <div class="card-surface p-5">
        <i data-lucide={tile.icon} class="w-6 h-6 text-accent"></i>
        <p class="font-heading font-extrabold text-2xl text-primary mt-2">{tile.value}</p>
        <p class="text-xs font-heading font-semibold text-muted uppercase mt-0.5">{tile.sub}</p>
        <p class="text-sm text-ink mt-0.5">{tile.label}</p>
      </div>
    ))}
  </div>

  <!-- Umum -->
  <section id="umum" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Profil Umum</h2>
    <p class="text-muted mt-2 max-w-3xl leading-relaxed">
      Desa Citarik terletak di Kecamatan Palabuhanratu, Kabupaten Sukabumi, Provinsi Jawa Barat. Data profil di halaman ini mengacu pada isian resmi Prodeskel (Profil Desa dan Kelurahan) Maret 2025, kode desa 3202110005.
    </p>
    <div class="prose max-w-none mt-4 text-muted leading-relaxed" set:html={umum?.content_html ?? ''} />
    <div class="grid sm:grid-cols-2 gap-4 mt-6">
      {[
        { label: 'Kecamatan', value: kecamatan },
        { label: 'Kabupaten', value: kabupaten },
        { label: 'Provinsi', value: 'Jawa Barat' },
        { label: 'Kode desa', value: String(stUmum.kode_desa ?? '3202110005') },
      ].map(row => (
        <div class="flex justify-between py-3 border-b border-border">
          <span class="font-heading font-semibold text-ink">{row.label}</span>
          <span class="text-muted">{row.value}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Geografis -->
  <section id="geografis" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Kondisi Geografis</h2>
    <p class="text-muted mt-2 max-w-3xl leading-relaxed">
      Menurut Prodeskel 2025, wilayah Desa Citarik mencakup dataran rendah, perbukitan, dataran tinggi/pegunungan, lereng gunung, serta kawasan aliran dan bantaran sungai. Batas utara berdekatan dengan Gunung Jayanti; selatan berbatasan dengan Desa Cidadap / Sungai Cimandiri.
    </p>
    <div class="prose max-w-none mt-4 text-muted leading-relaxed" set:html={geografis?.content_html ?? ''} />
    <div class="grid sm:grid-cols-3 gap-4 mt-6">
      {[
        { icon: 'layers', label: 'Luas wilayah', value: (stUmum.luas ? `${stUmum.luas} Ha` : '526,38 Ha') },
        { icon: 'thermometer', label: 'Suhu rata-rata', value: '30 °C' },
        { icon: 'cloud-rain', label: 'Bulan hujan', value: '±5 bulan' },
      ].map(item => (
        <div class="card-surface p-5">
          <i data-lucide={item.icon} class="w-6 h-6 text-accent"></i>
          <p class="text-xs font-heading font-semibold text-muted uppercase mt-2">{item.label}</p>
          <p class="font-heading font-bold text-xl text-primary mt-0.5">{item.value}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Demografi (sumber: Prodeskel Profil Desa dan Kelurahan, Maret 2025) -->
  <section id="demografi" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Demografi Penduduk</h2>
    <p class="text-muted mt-2 max-w-3xl leading-relaxed">
      Data kependudukan: total &amp; kategori dari Prodeskel Maret 2025; rincian jiwa/RW/RT per dusun dari Laporan Tahunan 2017–2018. Kategori tanpa angka disembunyikan.
    </p>

    <div class="mt-6 space-y-10">
      {statCats.map((cat) => {
        if (cat.layout === 'dusun') {
          const rows = cat.rows.map((r) => ({ label: r.label, ...parseDusunValue(r.value_json) }));
          const hasLP = rows.some((d) => d.l > 0 || d.p > 0);
          const jiwaMax = Math.max(1, ...rows.map((d) => d.jiwa));
          const dusunMax = Math.max(1, ...rows.flatMap((d) => [d.l, d.p]));
          return (
            <div>
              <h3 class="font-heading font-bold text-lg text-primary mb-1">{cat.label}</h3>
              {hasLP ? (
                <div class="flex items-center gap-4 mb-3 text-sm text-muted">
                  <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style="background:var(--color-accent);"></span>Laki-laki</span>
                  <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style="background:var(--color-cta);"></span>Perempuan</span>
                </div>
              ) : (
                <p class="text-xs text-muted mb-3">Sumber jiwa: Laporan Tahunan Desa 2017–2018 · RW/RT per dusun</p>
              )}
              <div class="space-y-4">
                {rows.map((d) => (
                  <div>
                    <div class="flex items-baseline justify-between mb-1">
                      <span class="font-heading font-semibold text-sm text-ink">{d.label}</span>
                      <span class="text-xs text-muted">
                        {fmt(d.jiwa)} jiwa
                        {d.jmlRw > 0 && <> · {d.jmlRw} RW</>}
                        {d.jmlRt > 0 && <> · {d.jmlRt} RT</>}
                        {d.kk > 0 && <> · {fmt(d.kk)} KK</>}
                      </span>
                    </div>
                    {hasLP ? (
                      <>
                        <div class="flex items-center gap-2 mb-1">
                          <div class="flex-1 h-5 rounded-md" style="background:var(--color-line);">
                            <div class="h-full" style={`width:${barPct(d.l, dusunMax)}%; background:var(--color-accent); border-radius:0 4px 4px 0;`}></div>
                          </div>
                          <span class="w-14 shrink-0 text-right text-xs font-heading font-semibold text-ink tabular-nums">{fmt(d.l)}</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <div class="flex-1 h-5 rounded-md" style="background:var(--color-line);">
                            <div class="h-full" style={`width:${barPct(d.p, dusunMax)}%; background:var(--color-cta); border-radius:0 4px 4px 0;`}></div>
                          </div>
                          <span class="w-14 shrink-0 text-right text-xs font-heading font-semibold text-ink tabular-nums">{fmt(d.p)}</span>
                        </div>
                      </>
                    ) : (
                      <div class="flex items-center gap-2">
                        <div class="flex-1 h-5 rounded-md" style="background:var(--color-line);">
                          <div class="h-full" style={`width:${barPct(d.jiwa, jiwaMax)}%; background:var(--color-accent); border-radius:0 4px 4px 0;`}></div>
                        </div>
                        <span class="w-16 shrink-0 text-right text-xs font-heading font-semibold text-ink tabular-nums">{fmt(d.jiwa)}</span>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          );
        }
        const rows = cat.rows.map((r) => ({ label: r.label, value: parseSimpleValue(r.value_json) }));
        const max = Math.max(1, ...rows.map((d) => d.value));
        return (
          <div>
            <h3 class="font-heading font-bold text-lg text-primary mb-3">{cat.label}</h3>
            <div class="space-y-2">
              {rows.map((d) => (
                <div class="flex items-center gap-3">
                  <span class="w-40 shrink-0 text-sm text-ink">{d.label}</span>
                  <div class="flex-1 h-5 rounded-md" style="background:var(--color-line);">
                    <div class="h-full" style={`width:${barPct(d.value, max)}%; background:var(--color-accent); border-radius:0 4px 4px 0;`}></div>
                  </div>
                  <span class="w-14 shrink-0 text-right text-sm font-heading font-semibold text-primary tabular-nums">{fmt(d.value)}</span>
                </div>
              ))}
            </div>
          </div>
        );
      })}

      <details class="border border-border rounded-xl p-4">
        <summary class="font-heading font-semibold text-sm text-primary cursor-pointer">Lihat semua data dalam bentuk tabel</summary>
        <div class="mt-4 grid sm:grid-cols-2 gap-6 text-sm">
          {statCats.map((cat) => (
            <table class="w-full">
              <caption class="text-left font-heading font-semibold mb-1">{cat.label}</caption>
              {cat.layout === 'dusun' ? (
                <>
                  <thead><tr class="text-muted text-xs"><th class="text-left font-normal py-1">Wilayah</th><th class="text-right font-normal">Jiwa</th><th class="text-right font-normal">RW</th><th class="text-right font-normal">RT</th></tr></thead>
                  <tbody>
                    {cat.rows.map((r) => {
                      const d = parseDusunValue(r.value_json);
                      return (
                        <tr class="border-t border-border"><td class="py-1">{r.label}</td><td class="text-right tabular-nums">{fmt(d.jiwa)}</td><td class="text-right tabular-nums">{d.jmlRw || '—'}</td><td class="text-right tabular-nums">{d.jmlRt || '—'}</td></tr>
                      );
                    })}
                  </tbody>
                </>
              ) : (
                <tbody>
                  {cat.rows.map((r) => (
                    <tr class="border-t border-border"><td class="py-1">{r.label}</td><td class="text-right tabular-nums">{fmt(parseSimpleValue(r.value_json))}</td></tr>
                  ))}
                </tbody>
              )}
            </table>
          ))}
        </div>
      </details>
    </div>
  </section>

  <!-- Sejarah -->
  <section id="sejarah" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Sejarah Desa</h2>
    <div class="prose max-w-none mt-4 text-muted leading-relaxed" set:html={sejarah?.content_html ?? `
      <p>Menurut dokumen Profil Desa Citarik (PPT), pemerintahan desa tercatat sejak tahun 1912. Nama desa berkembang dari Cihoe (sampai 1912), Kalideres (1912–1930), lalu Citarik sejak 1930—terkait pemaknaan Sunda dan batas alam Kali Citarik.</p>
      <p>Pada 2012, Perda Kabupaten Sukabumi Nomor 21 Tahun 2012 memekarkan Desa Jayanti dari wilayah Citarik. Pusat pemerintahan berada di Dusun III, Kp. Legok Loa RT 001/RW 014.</p>
    `} />
  </section>

  <!-- Peta -->
  <section id="peta" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Peta Desa</h2>
    <p class="text-muted mt-2">Lokasi Kantor Desa Citarik di Kecamatan Palabuhanratu, Kabupaten Sukabumi.</p>
    <div id="profil-map" class="mt-4 rounded-xl overflow-hidden border border-border shadow-sm" style="height: 380px; z-index: 0;"></div>
    <p class="text-sm text-muted mt-2 flex items-center gap-1.5">
      <i data-lucide="info" class="w-4 h-4"></i>
      Kantor Desa: -7.009933, 106.581037 ·
      <a href="/peta" class="text-accent hover:underline font-medium">Buka peta interaktif lengkap →</a>
    </p>
  </section>

  <!-- CTA Pemerintahan -->
  <section style="scroll-margin-top: 120px;">
    <div class="bg-primary text-white rounded-xl p-8 flex flex-col sm:flex-row items-center gap-6">
      <div class="flex-1">
        <h2 class="text-2xl font-heading font-extrabold">Pemerintahan Desa</h2>
        <p class="text-white/80 mt-2">Pelajari struktur organisasi, perangkat desa, visi misi, dan tugas fungsi pemerintahan Desa Citarik.</p>
      </div>
      <a href="/pemerintahan" class="btn shrink-0 bg-white text-primary hover:bg-sand border border-transparent">
        <i data-lucide="landmark" class="w-5 h-5"></i> Lihat Pemerintahan
      </a>
    </div>
  </section>

</div>

</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var map = L.map('profil-map', { scrollWheelZoom: false }).setView([-7.009933224557312, 106.58103748650889], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
    L.marker([-7.009933224557312, 106.58103748650889]).addTo(map).bindPopup('<b>Kantor Desa Citarik</b><br>Kp. Legok Loa · Kec. Palabuhanratu');
  });
</script>

<style>
  [id] { scroll-margin-top: 120px; }
</style>
