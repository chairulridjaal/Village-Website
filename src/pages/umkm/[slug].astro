---
import Layout from '../../components/Layout.astro';
import { getUmkmBySlug } from '../../lib/db/umkm';
import { getMediaForEntity } from '../../lib/db/media';
import { getEnv } from '@lib/env';
import { SITE_URL } from '@lib/site';

const { slug } = Astro.params as { slug: string };
const env = getEnv();

const umkm = env ? await getUmkmBySlug(slug, env.DB) : null;
if (!umkm) return Astro.redirect('/404');

const mediaList = env ? await getMediaForEntity('umkm', umkm.id, env.DB) : [];
const cover = mediaList[0];
const menuItems = (umkm.menu ?? '').split('\n').map(s => s.trim()).filter(Boolean);
const caraPesanLines = (umkm.cara_pesan ?? '').split('\n').map(s => s.trim()).filter(Boolean);
const canonicalUrl = new URL(`/umkm/${slug}`, Astro.site ?? SITE_URL).href;
---

<Layout
  title={`${umkm.nama} | UMKM Desa Citarik`}
  description={`${umkm.nama} · ${umkm.kategori} · ${umkm.lokasi ?? 'Desa Citarik'}`}
  ogImage={cover ? `/api/media/${encodeURIComponent(cover.r2_key_display)}` : undefined}
>

  <section class="page-hero">
    <div class="page-hero__media" style="height: 10.5rem;">
      {cover ? (
        <img src={`/api/media/${encodeURIComponent(cover.r2_key_display)}`} alt={cover.alt || umkm.nama} />
      ) : (
        <div class="w-full h-full" style="background: linear-gradient(135deg, #0E4A6E, #0A3650);"></div>
      )}
    </div>
    <div class="page-hero__overlay"></div>
    <div class="page-hero__content">
      <div class="container-page">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href="/">Beranda</a>
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
          <a href="/umkm">Direktori UMKM</a>
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
          <span class="font-medium text-white">{umkm.nama}</span>
        </nav>
        <h1 class="text-3xl md:text-4xl font-heading font-extrabold mt-1.5">{umkm.nama}</h1>
        <p class="text-white/75 mt-1">{umkm.kategori}</p>
      </div>
    </div>
  </section>

  <div class="container-page py-10 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10">

      <div>
        {mediaList.length > 1 && (
          <div class="grid grid-cols-3 gap-2 mb-6">
            {mediaList.slice(1, 7).map(m => (
              <div class="aspect-square rounded-lg overflow-hidden border border-border">
                <img src={`/api/media/${encodeURIComponent(m.r2_key_thumb)}`} alt={m.alt}
                  class="w-full h-full object-cover" loading="lazy" />
              </div>
            ))}
          </div>
        )}

        <div class="umkm-content mb-6">
          <div class="prose max-w-none" set:html={umkm.deskripsi_html} />

          {menuItems.length > 0 && (
            <section>
              <h2>Produk</h2>
              <ul>{menuItems.map(item => <li>{item}</li>)}</ul>
            </section>
          )}

          {umkm.jam_buka && (
            <section>
              <h2>Jam Buka</h2>
              <p>{umkm.jam_buka}</p>
            </section>
          )}

          {caraPesanLines.length > 0 && (
            <section>
              <h2>Cara Pesan &amp; Pembayaran</h2>
              {caraPesanLines.map(line => <p>{line}</p>)}
            </section>
          )}
        </div>

        {umkm.lokasi && (
          <div class="flex items-start gap-3 p-4 rounded-xl border border-border bg-bg">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <p class="font-heading font-medium text-sm">Lokasi</p>
              <p class="text-muted text-sm">{umkm.lokasi}</p>
              {umkm.google_maps_url && (
                <a href={umkm.google_maps_url} target="_blank" rel="noopener noreferrer"
                  class="text-accent text-sm hover:underline">
                  Buka di Google Maps →
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <aside class="lg:sticky lg:top-24 self-start">
        <div class="card-surface p-6 space-y-3">
          <h2 class="font-heading font-bold text-lg mb-2 text-primary">Hubungi UMKM</h2>

          {umkm.wa_number ? (
            <a href={`https://wa.me/${umkm.wa_number.replace(/\D/g,'')}`} target="_blank" rel="noopener noreferrer"
              class="btn btn-cta w-full">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
              Hubungi via WhatsApp
            </a>
          ) : umkm.telepon ? (
            <a href={`tel:${umkm.telepon}`} class="btn btn-secondary w-full">Telepon</a>
          ) : null}

          {umkm.toko_online_url && (
            <a href={umkm.toko_online_url} target="_blank" rel="noopener noreferrer"
              class="btn btn-secondary w-full">
              Beli di Toko Online
            </a>
          )}

          {(umkm.google_maps_url || umkm.qris_r2_key) && (
            <div class="grid grid-cols-2 gap-2">
              {umkm.google_maps_url && (
                <a href={umkm.google_maps_url} target="_blank" rel="noopener noreferrer"
                  class="flex items-center justify-center px-3 py-2 rounded-md font-heading font-medium text-sm border border-border hover:bg-sand min-h-[44px]">
                  Google Maps
                </a>
              )}
              {umkm.qris_r2_key && (
                <a href={`/api/media/${encodeURIComponent(umkm.qris_r2_key)}`} target="_blank"
                  class="flex items-center justify-center px-3 py-2 rounded-md font-heading font-medium text-sm border border-border hover:bg-sand min-h-[44px]">
                  QRIS
                </a>
              )}
            </div>
          )}

          <div class="pt-3 border-t border-border">
            <p class="text-muted text-xs font-heading mb-2">Bagikan</p>
            <div class="flex gap-2">
              <a href={`https://wa.me/?text=${encodeURIComponent(umkm.nama + ': ' + canonicalUrl)}`}
                target="_blank" rel="noopener noreferrer" aria-label="Bagikan via WhatsApp"
                class="w-10 h-10 rounded-md border border-border flex items-center justify-center hover:bg-sand">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
              </a>
              <button id="copy-link" type="button" aria-label="Salin tautan"
                class="w-10 h-10 rounded-md border border-border flex items-center justify-center hover:bg-sand cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              </button>
              <span id="copy-confirm" class="text-xs text-cta hidden self-center ml-1">Tautan disalin</span>
            </div>
          </div>
        </div>

        <p class="text-xs text-muted mt-3 text-center italic leading-relaxed">
          Transaksi dilakukan langsung dengan UMKM. Pemerintah Desa Citarik tidak memungut biaya apapun.
        </p>
      </aside>

    </div>

    <div class="mt-10">
      <a href="/umkm" class="font-heading font-medium text-sm text-accent hover:text-primary transition-colors">
        ← Kembali ke Direktori UMKM
      </a>
    </div>
  </div>

</Layout>

<script define:vars={{ canonicalUrl }}>
  document.getElementById('copy-link')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(canonicalUrl);
    const msg = document.getElementById('copy-confirm');
    if (msg) { msg.classList.remove('hidden'); setTimeout(() => msg.classList.add('hidden'), 2000); }
  });
</script>
