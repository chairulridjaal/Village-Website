---
import Layout from '../../components/Layout.astro';
import { getUmkmBySlug } from '../../lib/db/umkm';
import { getMediaForEntity } from '../../lib/db/media';
import { getEnv } from '@lib/env';
import { SITE_URL } from '@lib/site';

const { slug } = Astro.params as { slug: string };
const env = getEnv();

const umkm = env ? await getUmkmBySlug(slug, env.DB) : null;
if (!umkm) return Astro.redirect('/404');

const mediaList = env ? await getMediaForEntity('umkm', umkm.id, env.DB) : [];
const cover = mediaList[0];
const menuItems = (umkm.menu ?? '').split('\n').map(s => s.trim()).filter(Boolean);
const caraPesanLines = (umkm.cara_pesan ?? '').split('\n').map(s => s.trim()).filter(Boolean);
const canonicalUrl = new URL(`/umkm/${slug}`, Astro.site ?? SITE_URL).href;

const galleryJson = JSON.stringify(
  mediaList.map(m => ({
    src: `/api/media/${encodeURIComponent(m.r2_key_display)}`,
    alt: m.alt || umkm.nama,
  }))
);
---

<Layout
  title={`${umkm.nama} | UMKM Desa Citarik`}
  description={`${umkm.nama} · ${umkm.kategori} · ${umkm.lokasi ?? 'Desa Citarik'}`}
  ogImage={cover ? `/api/media/${encodeURIComponent(cover.r2_key_display)}` : undefined}
>

  <section class="page-hero">
    <div class="page-hero__media" style="height: 10.5rem;">
      {cover ? (
        <img src={`/api/media/${encodeURIComponent(cover.r2_key_display)}`} alt={cover.alt || umkm.nama} />
      ) : (
        <div class="w-full h-full" style="background: linear-gradient(135deg, #0E4A6E, #0A3650);"></div>
      )}
    </div>
    <div class="page-hero__overlay"></div>
    <div class="page-hero__content">
      <div class="container-page">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href="/">Beranda</a>
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
          <a href="/umkm">Direktori UMKM</a>
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
          <span class="font-medium text-white">{umkm.nama}</span>
        </nav>
        <h1 class="text-3xl md:text-4xl font-heading font-extrabold mt-1.5">{umkm.nama}</h1>
        <p class="text-white/75 mt-1">{umkm.kategori}</p>
      </div>
    </div>
  </section>

  <div class="container-page py-10 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10">

      <div>
        {mediaList.length > 0 && (
          <div class="mb-6" id="umkm-gallery" data-gallery={galleryJson}>
            <div class="relative rounded-xl overflow-hidden border border-border bg-sand/40 aspect-[16/10] group">
              <button
                type="button"
                id="gallery-main-btn"
                class="absolute inset-0 w-full h-full cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                aria-label="Perbesar foto"
              >
                <img
                  id="gallery-main-img"
                  src={`/api/media/${encodeURIComponent(mediaList[0].r2_key_display)}`}
                  alt={mediaList[0].alt || umkm.nama}
                  class="w-full h-full object-cover"
                />
              </button>

              {mediaList.length > 1 && (
                <>
                  <button
                    type="button"
                    id="gallery-prev"
                    class="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/70 transition-colors z-10"
                    aria-label="Foto sebelumnya"
                  >
                    <i data-lucide="chevron-left" class="w-5 h-5"></i>
                  </button>
                  <button
                    type="button"
                    id="gallery-next"
                    class="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/70 transition-colors z-10"
                    aria-label="Foto berikutnya"
                  >
                    <i data-lucide="chevron-right" class="w-5 h-5"></i>
                  </button>
                  <div class="absolute bottom-3 left-1/2 -translate-x-1/2 px-2.5 py-1 rounded-full bg-black/55 text-white text-xs font-heading tabular-nums z-10">
                    <span id="gallery-counter">1 / {mediaList.length}</span>
                  </div>
                </>
              )}
            </div>

            {mediaList.length > 1 && (
              <div class="flex gap-2 mt-3 overflow-x-auto pb-1" role="tablist" aria-label="Thumbnail galeri">
                {mediaList.map((m, i) => (
                  <button
                    type="button"
                    class="gallery-thumb shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                    style={i === 0 ? 'border-color:var(--color-accent)' : 'border-color:transparent'}
                    data-index={i}
                    aria-label={`Foto ${i + 1}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                  >
                    <img
                      src={`/api/media/${encodeURIComponent(m.r2_key_thumb || m.r2_key_display)}`}
                      alt=""
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        <div class="umkm-content mb-6">
          <div class="prose max-w-none" set:html={umkm.deskripsi_html} />

          {menuItems.length > 0 && (
            <section>
              <h2>Produk</h2>
              <ul>{menuItems.map(item => <li>{item}</li>)}</ul>
            </section>
          )}

          {umkm.jam_buka && (
            <section>
              <h2>Jam Buka</h2>
              <p>{umkm.jam_buka}</p>
            </section>
          )}

          {caraPesanLines.length > 0 && (
            <section>
              <h2>Cara Pesan &amp; Pembayaran</h2>
              {caraPesanLines.map(line => <p>{line}</p>)}
            </section>
          )}
        </div>

        {umkm.lokasi && (
          <div class="flex items-start gap-3 p-4 rounded-xl border border-border bg-bg">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <p class="font-heading font-medium text-sm">Lokasi</p>
              <p class="text-muted text-sm">{umkm.lokasi}</p>
              {umkm.google_maps_url && (
                <a href={umkm.google_maps_url} target="_blank" rel="noopener noreferrer"
                  class="text-accent text-sm hover:underline">
                  Buka di Google Maps →
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <aside class="lg:sticky lg:top-24 self-start">
        <div class="card-surface p-6 space-y-3">
          <h2 class="font-heading font-bold text-lg mb-2 text-primary">Hubungi UMKM</h2>

          {umkm.wa_number ? (
            <a href={`https://wa.me/${umkm.wa_number.replace(/\D/g,'')}`} target="_blank" rel="noopener noreferrer"
              class="btn btn-cta w-full">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
              Hubungi via WhatsApp
            </a>
          ) : umkm.telepon ? (
            <a href={`tel:${umkm.telepon}`} class="btn btn-secondary w-full">Telepon</a>
          ) : null}

          {umkm.toko_online_url && (
            <a href={umkm.toko_online_url} target="_blank" rel="noopener noreferrer"
              class="btn btn-secondary w-full">
              Beli di Toko Online
            </a>
          )}

          {(umkm.google_maps_url || umkm.qris_r2_key) && (
            <div class="grid grid-cols-2 gap-2">
              {umkm.google_maps_url && (
                <a href={umkm.google_maps_url} target="_blank" rel="noopener noreferrer"
                  class="flex items-center justify-center px-3 py-2 rounded-md font-heading font-medium text-sm border border-border hover:bg-sand min-h-[44px]">
                  Google Maps
                </a>
              )}
              {umkm.qris_r2_key && (
                <a href={`/api/media/${encodeURIComponent(umkm.qris_r2_key)}`} target="_blank"
                  class="flex items-center justify-center px-3 py-2 rounded-md font-heading font-medium text-sm border border-border hover:bg-sand min-h-[44px]">
                  QRIS
                </a>
              )}
            </div>
          )}

          <div class="pt-3 border-t border-border">
            <p class="text-muted text-xs font-heading mb-2">Bagikan</p>
            <div class="flex gap-2">
              <a href={`https://wa.me/?text=${encodeURIComponent(umkm.nama + ': ' + canonicalUrl)}`}
                target="_blank" rel="noopener noreferrer" aria-label="Bagikan via WhatsApp"
                class="w-10 h-10 rounded-md border border-border flex items-center justify-center hover:bg-sand">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
              </a>
              <button id="copy-link" type="button" aria-label="Salin tautan"
                class="w-10 h-10 rounded-md border border-border flex items-center justify-center hover:bg-sand cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              </button>
              <span id="copy-confirm" class="text-xs text-cta hidden self-center ml-1">Tautan disalin</span>
            </div>
          </div>
        </div>

        <p class="text-xs text-muted mt-3 text-center italic leading-relaxed">
          Transaksi dilakukan langsung dengan UMKM. Pemerintah Desa Citarik tidak memungut biaya apapun.
        </p>
      </aside>

    </div>

    <div class="mt-10">
      <a href="/umkm" class="font-heading font-medium text-sm text-accent hover:text-primary transition-colors">
        ← Kembali ke Direktori UMKM
      </a>
    </div>
  </div>

  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Pratinjau foto"
  >
    <button type="button" id="lightbox-close" class="absolute top-4 right-4 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25" aria-label="Tutup">
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
    <button type="button" id="lightbox-prev" class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25" aria-label="Sebelumnya">
      <i data-lucide="chevron-left" class="w-6 h-6"></i>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[88vh] max-w-[92vw] object-contain rounded-lg shadow-2xl" />
    <button type="button" id="lightbox-next" class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/15 text-white flex items-center justify-center hover:bg-white/25" aria-label="Berikutnya">
      <i data-lucide="chevron-right" class="w-6 h-6"></i>
    </button>
  </div>

</Layout>

<script define:vars={{ canonicalUrl }}>
  document.getElementById('copy-link')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(canonicalUrl);
    const msg = document.getElementById('copy-confirm');
    if (msg) { msg.classList.remove('hidden'); setTimeout(() => msg.classList.add('hidden'), 2000); }
  });

  const root = document.getElementById('umkm-gallery');
  if (root) {
    /** @type {{src:string,alt:string}[]} */
    const items = JSON.parse(root.dataset.gallery || '[]');
    let index = 0;

    const mainImg = document.getElementById('gallery-main-img');
    const counter = document.getElementById('gallery-counter');
    const thumbs = Array.from(document.querySelectorAll('.gallery-thumb'));
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');

    function show(i) {
      if (!items.length) return;
      index = (i + items.length) % items.length;
      const item = items[index];
      if (mainImg) {
        mainImg.src = item.src;
        mainImg.alt = item.alt;
      }
      if (counter) counter.textContent = `${index + 1} / ${items.length}`;
      thumbs.forEach((t, ti) => {
        const on = ti === index;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.style.borderColor = on ? 'var(--color-accent)' : 'transparent';
        t.style.opacity = on ? '1' : '0.72';
      });
      if (lightboxImg && lightbox && !lightbox.classList.contains('hidden')) {
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
      }
    }

    function openLightbox() {
      if (!lightbox || !lightboxImg || !items.length) return;
      lightboxImg.src = items[index].src;
      lightboxImg.alt = items[index].alt;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    document.getElementById('gallery-prev')?.addEventListener('click', (e) => { e.stopPropagation(); show(index - 1); });
    document.getElementById('gallery-next')?.addEventListener('click', (e) => { e.stopPropagation(); show(index + 1); });
    document.getElementById('gallery-main-btn')?.addEventListener('click', openLightbox);
    thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.index || 0))));

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => show(index - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => show(index + 1));
    lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

    document.addEventListener('keydown', (e) => {
      if (!items.length) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    show(0);
  }
</script>
