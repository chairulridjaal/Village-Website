---
import Layout from '../components/Layout.astro';
import { getSection } from '../lib/db/page-section';
import { getPerangkatDesa } from '../lib/db/perangkat-desa';
import { getPengaturan } from '../lib/db/pengaturan';
import { getStatistikFull, parseDusunValue } from '../lib/db/statistik';
import { getEnv } from '@lib/env';

const env = getEnv();
const [visiMisi, ruangLingkup, tugasFungsi, perangkat, s, statCats] = await Promise.all([
  env ? getSection('pemerintahan-visi-misi', env.DB) : null,
  env ? getSection('pemerintahan-ruang-lingkup', env.DB) : null,
  env ? getSection('pemerintahan-tugas-fungsi', env.DB) : null,
  env ? getPerangkatDesa(env.DB) : [],
  env ? getPengaturan(env.DB) : {},
  env ? getStatistikFull(env.DB, true).catch(() => []) : Promise.resolve([]),
]);

const tiers = {
  kepala: perangkat.find(p => p.jabatan?.toLowerCase().includes('kepala desa')),
  sekdes: perangkat.find(p => p.jabatan?.toLowerCase().includes('sekretaris')),
  others: perangkat.filter(p => !p.jabatan?.toLowerCase().includes('kepala desa') && !p.jabatan?.toLowerCase().includes('sekretaris')),
};

const fmt = (n: number) => n.toLocaleString('id-ID');
const stUmum = JSON.parse(s.stat_umum ?? '{}') as Record<string, unknown>;

// Prefer stat_baris (layout dusun); fallback legacy pengaturan.stat_dusun
const dusunCat = statCats.find((c) => c.layout === 'dusun');
let wilayahData: { dusun: string; rw: string; jmlRw: number; jiwa: number; kk: number }[] = [];
if (dusunCat && dusunCat.rows.length > 0) {
  wilayahData = dusunCat.rows.map((r) => {
    const d = parseDusunValue(r.value_json);
    return { dusun: r.label, rw: d.rw, jmlRw: d.jmlRw, jiwa: d.l + d.p, kk: d.kk };
  });
} else {
  const stDusun: { label: string; rw?: string; jmlRw?: number; l: number; p: number; kk: number }[] =
    JSON.parse(s.stat_dusun ?? '[]');
  wilayahData = stDusun.map((d) => ({
    dusun: d.label, rw: d.rw ?? '', jmlRw: d.jmlRw ?? 0, jiwa: d.l + d.p, kk: d.kk,
  }));
}

const sumJiwa = wilayahData.reduce((sum, d) => sum + d.jiwa, 0);
const sumKK = wilayahData.reduce((sum, d) => sum + d.kk, 0);
// Total resmi dari Prodeskel (stat_umum) — baris dusun bisa masih 0 sambil diisi admin
const totalJiwa = sumJiwa > 0 ? sumJiwa : Number(stUmum.penduduk) || 0;
const totalKK = sumKK > 0 ? sumKK : Number(stUmum.kk) || 0;
const jumlahDusun = Number(stUmum.dusun) || Math.max(wilayahData.length, 4);
const jumlahRw = Number(stUmum.rw) || 10;
const jumlahRt = Number(stUmum.rt) || 50;
---

<Layout
  title="Pemerintahan Desa | Desa Citarik"
  description="Pemerintahan Desa Citarik: perangkat desa, struktur organisasi, visi & misi, ruang lingkup, tugas & fungsi."
>

<section class="page-hero">
  <div class="page-hero__media">
    <img src="/images/kantor_desa.png" alt="Kantor Desa Citarik" />
  </div>
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content">
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Beranda</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <a href="/profil">Profil</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <span class="font-medium text-white">Pemerintahan</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold mt-1.5">Pemerintahan Desa Citarik</h1>
      <p class="text-white/85 mt-1.5 max-w-xl">Perangkat, struktur, dan visi-misi penyelenggara pemerintahan desa.</p>
    </div>
  </div>
</section>

<div class="subnav">
  <div class="container-page py-2 flex gap-2 overflow-x-auto">
    {[
      ['#perangkat', 'Perangkat Desa'],
      ['#struktur', 'Struktur Organisasi'],
      ['#visi-misi', 'Visi & Misi'],
      ['#ruang-lingkup', 'Ruang Lingkup'],
      ['#tugas-fungsi', 'Tugas & Fungsi'],
    ].map(([href, label]) => (
      <a href={href} class="subnav-link">{label}</a>
    ))}
  </div>
</div>

<div class="container-page py-10 space-y-14">

  <!-- Perangkat Desa -->
  <section id="perangkat" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Perangkat Desa</h2>
    <p class="text-muted mt-2 max-w-2xl">Jajaran perangkat Pemerintah Desa Citarik, dari pimpinan hingga pelaksana.</p>

    {perangkat.length > 0 ? (
      <div class="mt-8 space-y-6">
        {tiers.kepala && (
          <div class="flex flex-col items-center">
            <div class="card-surface p-6 sm:p-8 text-center w-full max-w-sm">
              <div class="w-36 h-36 rounded-full mx-auto ring-4 ring-sand overflow-hidden" style="background: linear-gradient(135deg, #0E4A6E, #0E9AA7);">
                <div class="w-full h-full flex items-center justify-center font-heading font-bold text-4xl text-white">{tiers.kepala.nama[0]}</div>
              </div>
              <span class="inline-block mt-4 text-xs font-heading font-bold px-3 py-1 rounded-full bg-primary text-white uppercase tracking-wide">Kepala Desa</span>
              <h3 class="font-heading font-bold text-2xl text-ink mt-2">{tiers.kepala.nama}</h3>
              <p class="text-muted text-sm mt-1">Pemimpin penyelenggaraan pemerintahan desa</p>
            </div>
            <span class="w-px h-8 bg-line" aria-hidden="true"></span>
          </div>
        )}
        {tiers.sekdes && (
          <div class="flex flex-col items-center">
            <div class="card-surface p-6 text-center w-full max-w-xs">
              <div class="w-28 h-28 rounded-full mx-auto ring-4 ring-sand overflow-hidden" style="background: linear-gradient(135deg, #0A3650, #0E9AA7);">
                <div class="w-full h-full flex items-center justify-center font-heading font-bold text-3xl text-white">{tiers.sekdes.nama[0]}</div>
              </div>
              <span class="inline-block mt-3 text-xs font-heading font-bold px-3 py-1 rounded-full bg-accent text-white uppercase tracking-wide">Sekretaris Desa</span>
              <h3 class="font-heading font-bold text-lg text-ink mt-2">{tiers.sekdes.nama}</h3>
            </div>
            <span class="w-px h-8 bg-line" aria-hidden="true"></span>
          </div>
        )}
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
          {tiers.others.map(p => (
            <div class="card-surface p-5 text-center">
              <div class="w-20 h-20 rounded-full mx-auto ring-2 ring-sand overflow-hidden" style="background: linear-gradient(135deg, #0E4A6E, #0E9AA7);">
                <div class="w-full h-full flex items-center justify-center font-heading font-bold text-2xl text-white">{p.nama[0]}</div>
              </div>
              <span class="inline-block mt-3 text-[11px] font-heading font-semibold px-2.5 py-0.5 rounded-full bg-sand text-primary uppercase">{p.jabatan}</span>
              <h3 class="font-heading font-semibold text-ink mt-1.5">{p.nama}</h3>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="mt-8 space-y-6">
        <!-- Kepala Desa -->
        <div class="flex flex-col items-center">
          <div class="card-surface p-6 sm:p-8 text-center w-full max-w-sm">
            <div class="w-36 h-36 rounded-full mx-auto ring-4 ring-sand flex items-center justify-center" style="background: linear-gradient(135deg, #0E4A6E, #0E9AA7);">
              <i data-lucide="user" class="w-16 h-16 text-white/50"></i>
            </div>
            <span class="inline-block mt-4 text-xs font-heading font-bold px-3 py-1 rounded-full bg-primary text-white uppercase tracking-wide">Kepala Desa</span>
            <h3 class="font-heading font-bold text-xl text-ink mt-2">[ Nama Kepala Desa ]</h3>
            <p class="text-muted text-sm mt-1">Pemimpin penyelenggaraan pemerintahan desa</p>
          </div>
          <span class="w-px h-8 bg-line" aria-hidden="true"></span>
        </div>
        <!-- Sekdes -->
        <div class="flex flex-col items-center">
          <div class="card-surface p-6 text-center w-full max-w-xs">
            <div class="w-28 h-28 rounded-full mx-auto ring-4 ring-sand flex items-center justify-center" style="background: linear-gradient(135deg, #0A3650, #0E9AA7);">
              <i data-lucide="user" class="w-12 h-12 text-white/50"></i>
            </div>
            <span class="inline-block mt-3 text-xs font-heading font-bold px-3 py-1 rounded-full bg-accent text-white uppercase tracking-wide">Sekretaris Desa</span>
            <h3 class="font-heading font-bold text-lg text-ink mt-2">[ Nama ]</h3>
          </div>
          <span class="w-px h-8 bg-line" aria-hidden="true"></span>
        </div>
        <!-- Tier 3 -->
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
          {['Kaur Keuangan','Kaur Umum & TU','Kasi Pemerintahan','Kasi Kesejahteraan','Kasi Pelayanan','Kepala Dusun'].map((jabatan, i) => (
            <div class="card-surface p-5 text-center">
              <div class="w-20 h-20 rounded-full mx-auto ring-2 ring-sand flex items-center justify-center" style={`background: linear-gradient(135deg, ${i % 2 === 0 ? '#0E4A6E, #0E9AA7' : '#0A3650, #0E4A6E'});`}>
                <i data-lucide="user" class="w-8 h-8 text-white/50"></i>
              </div>
              <span class="inline-block mt-3 text-[11px] font-heading font-semibold px-2.5 py-0.5 rounded-full bg-sand text-primary uppercase">{jabatan}</span>
              <h3 class="font-heading font-semibold text-ink mt-1.5">[ Nama ]</h3>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- Struktur Organisasi -->
  <section id="struktur" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Struktur Organisasi</h2>
    <p class="text-muted mt-2 max-w-2xl">Bagan struktur organisasi Pemerintah Desa Citarik beserta jajaran perangkatnya.</p>
    <div class="mt-4 rounded-xl overflow-hidden border border-border shadow-sm">
      <img src="/images/struktur_organisasi.png" alt="Bagan Struktur Organisasi Desa Citarik" class="w-full h-auto object-cover" />
    </div>
  </section>

  <!-- Visi & Misi -->
  <section id="visi-misi" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary mb-6">Visi & Misi</h2>
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="bg-primary text-white rounded-xl p-7">
        <span class="inline-flex items-center gap-2 text-white/80 font-heading font-semibold">
          <i data-lucide="target" class="w-5 h-5"></i> Visi
        </span>
        <p class="text-xl font-heading font-semibold mt-3 leading-snug" set:html={visiMisi?.content_html ?? '"Mewujudkan Desa Citarik yang maju, mandiri, dan sejahtera berbasis potensi lokal yang berkelanjutan."'} />
      </div>
      <div class="card-surface p-7">
        <span class="inline-flex items-center gap-2 text-primary font-heading font-semibold">
          <i data-lucide="list-checks" class="w-5 h-5"></i> Misi
        </span>
        <ul class="mt-3 space-y-2.5">
          {[
            'Meningkatkan pelayanan publik yang transparan dan akuntabel.',
            'Mengembangkan potensi ekonomi dan UMKM lokal.',
            'Menjaga kelestarian lingkungan pesisir dan sumber daya alam.',
            'Memperkuat partisipasi dan gotong royong masyarakat.',
          ].map((item, i) => (
            <li class="flex gap-3">
              <span class="w-6 h-6 rounded-full bg-sand text-primary grid place-items-center text-sm font-heading font-bold shrink-0">{i + 1}</span>
              <span class="text-muted">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Ruang Lingkup -->
  <section id="ruang-lingkup" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Ruang Lingkup</h2>
    <p class="text-muted mt-2 max-w-3xl leading-relaxed" set:html={ruangLingkup?.content_html ?? 'Bagian ini menjelaskan cakupan wilayah administratif Desa Citarik, jumlah dusun/RW/RT, serta lingkup kewenangan dan layanan yang diselenggarakan pemerintah desa bagi masyarakat.'} />
    <div class="grid sm:grid-cols-4 gap-4 mt-4">
      {[
        { icon: 'layers', label: 'Dusun', value: String(jumlahDusun) },
        { icon: 'grid-3x3', label: 'RW', value: String(jumlahRw) },
        { icon: 'grid-2x2', label: 'RT', value: String(jumlahRt) },
        { icon: 'users', label: 'Kepala Keluarga', value: fmt(totalKK) },
      ].map(item => (
        <div class="card-surface p-5">
          <i data-lucide={item.icon} class="w-6 h-6 text-accent"></i>
          <p class="text-xs font-heading font-semibold text-muted uppercase mt-2">{item.label}</p>
          <p class="font-heading font-bold text-xl text-primary mt-0.5">{item.value}</p>
        </div>
      ))}
    </div>

    <!-- Rincian per dusun -->
    <div class="mt-6 overflow-x-auto rounded-xl border border-border">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-sand text-left">
            <th class="px-4 py-3 font-heading font-semibold text-ink">Dusun</th>
            <th class="px-4 py-3 font-heading font-semibold text-ink">RW</th>
            <th class="px-4 py-3 font-heading font-semibold text-ink text-right">Jumlah RW</th>
            <th class="px-4 py-3 font-heading font-semibold text-ink text-right">Penduduk (Jiwa)</th>
            <th class="px-4 py-3 font-heading font-semibold text-ink text-right">KK</th>
          </tr>
        </thead>
        <tbody>
          {wilayahData.map(d => (
            <tr class="border-t border-border bg-white">
              <td class="px-4 py-3 font-heading font-medium text-ink">{d.dusun.startsWith('Dusun') ? d.dusun : `Dusun ${d.dusun}`}</td>
              <td class="px-4 py-3 text-muted">{d.rw || '—'}</td>
              <td class="px-4 py-3 text-right tabular-nums text-muted">{d.jmlRw || '—'}</td>
              <td class="px-4 py-3 text-right tabular-nums text-ink">{d.jiwa ? fmt(d.jiwa) : '—'}</td>
              <td class="px-4 py-3 text-right tabular-nums text-ink">{d.kk ? fmt(d.kk) : '—'}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-border bg-sand/60">
            <td class="px-4 py-3 font-heading font-bold text-primary">Total desa</td>
            <td class="px-4 py-3 text-muted">{jumlahRw} RW</td>
            <td class="px-4 py-3 text-right tabular-nums font-heading font-bold text-primary">{jumlahRw}</td>
            <td class="px-4 py-3 text-right tabular-nums font-heading font-bold text-primary">{fmt(totalJiwa)}</td>
            <td class="px-4 py-3 text-right tabular-nums font-heading font-bold text-primary">{fmt(totalKK)}</td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="text-xs text-muted mt-2">
      {jumlahRt} RT di {jumlahRw} RW pada {jumlahDusun} dusun (Prodeskel 2025).
      {sumJiwa === 0 && (
        <> Rincian jiwa/KK per dusun belum diisi — lengkapi di <a href="/admin/statistik-desa" class="text-accent underline">Statistik Desa</a> (panel admin).</>
      )}
    </p>
  </section>

  <!-- Tugas & Fungsi -->
  <section id="tugas-fungsi" style="scroll-margin-top: 120px;">
    <h2 class="text-2xl font-heading font-extrabold text-primary">Tugas & Fungsi</h2>
    <p class="text-muted mt-2 max-w-2xl">Peran masing-masing perangkat dalam penyelenggaraan pemerintahan desa.</p>
    <div class="grid sm:grid-cols-2 gap-4 mt-4">
      {[
        { icon: 'user-round', title: 'Kepala Desa', desc: 'Memimpin penyelenggaraan pemerintahan, pembangunan, dan pemberdayaan masyarakat desa.' },
        { icon: 'clipboard-list', title: 'Sekretaris Desa', desc: 'Membantu kepala desa di bidang administrasi dan tata usaha pemerintahan.' },
        { icon: 'wallet', title: 'Kaur Keuangan', desc: 'Mengelola keuangan dan penatausahaan anggaran desa.' },
        { icon: 'landmark', title: 'Kasi Pemerintahan', desc: 'Melaksanakan urusan pemerintahan, kependudukan, dan pertanahan.' },
        { icon: 'heart-handshake', title: 'Kasi Kesejahteraan', desc: 'Melaksanakan pemberdayaan masyarakat dan kesejahteraan sosial.' },
        { icon: 'clipboard-check', title: 'Kasi Pelayanan', desc: 'Menyelenggarakan pelayanan kepada masyarakat desa.' },
      ].map(item => (
        <div class="card-surface p-5">
          <h3 class="font-heading font-semibold text-ink flex items-center gap-2">
            <i data-lucide={item.icon} class="w-5 h-5 text-primary"></i> {item.title}
          </h3>
          <p class="text-sm text-muted mt-1.5">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

</div>

</Layout>

<script is:inline>
  // Subnav active state on scroll
  const links = [...document.querySelectorAll('.subnav-link')];
  const sections = links.map(l => {
    const id = l.getAttribute('href').slice(1);
    return document.getElementById(id);
  }).filter(Boolean);

  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('is-active'));
        const a = links.find(l => l.getAttribute('href') === '#' + e.target.id);
        if (a) a.classList.add('is-active');
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px' });

  sections.forEach(s => obs.observe(s));
</script>
