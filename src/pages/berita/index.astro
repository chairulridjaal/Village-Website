---
import Layout from '../../components/Layout.astro';
import { getPublishedBerita, formatTanggal, excerpt } from '../../lib/db/berita';
import { getCoversForType, mediaUrl } from '../../lib/db/media';
import { getEnv } from '@lib/env';

const env = getEnv();
const [beritaList, covers] = await Promise.all([
  env ? getPublishedBerita(env.DB) : [],
  env ? getCoversForType('berita', env.DB) : new Map(),
]);

const demoBerita = [
  { slug: 'gotong-royong-bersih-pantai', judul: 'Gotong Royong Bersih Pantai Citarik Menyambut Musim Kunjungan', published_at: '2026-07-12', content_html: '<p>Warga bersama Karang Taruna membersihkan pesisir Pantai Citarik dalam rangka menyambut meningkatnya kunjungan wisatawan ke kawasan Geopark Ciletuh.</p>', featured: true, img: '/images/gotong_royong.png' },
  { slug: 'pelatihan-digital-umkm', judul: 'Pelatihan Digital untuk UMKM Desa', published_at: '2026-07-08', content_html: '<p>Sepuluh pelaku UMKM mengikuti pelatihan foto produk dan WhatsApp Business yang difasilitasi oleh Tim KKNT IPB.</p>', featured: false, img: '/images/pelatihan_umkm.png' },
  { slug: 'peluncuran-situs-resmi', judul: 'Peluncuran Situs Resmi Desa Citarik', published_at: '2026-07-01', content_html: '<p>Desa Citarik kini punya kehadiran digital resmi yang dapat diakses siapa saja untuk mengeksplorasi potensi dan layanan desa.</p>', featured: false, img: '/images/pelatihan_umkm.png' },
  { slug: 'musyawarah-pengembangan-wisata', judul: 'Musyawarah Desa Bahas Pengembangan Wisata', published_at: '2026-06-24', content_html: '<p>Perangkat desa dan warga membahas rencana pengembangan kawasan Pantai Citarik menjadi destinasi ekowisata terpadu.</p>', featured: false, img: '/images/gotong_royong.png' },
  { slug: 'panen-raya-kopi', judul: 'Panen Raya Kopi Kebun Citarik', published_at: '2026-06-18', content_html: '<p>Hasil panen kopi tahun ini meningkat dibanding musim sebelumnya berkat metode budidaya baru yang diterapkan petani setempat.</p>', featured: false, img: '/images/kebun_sayur.png' },
  { slug: 'kerja-bakti-jalan-desa', judul: 'Kerja Bakti Perbaikan Jalan Desa', published_at: '2026-06-02', content_html: '<p>Warga bergotong royong memperbaiki ruas jalan menuju dermaga agar lebih nyaman dilalui nelayan dan wisatawan.</p>', featured: false, img: '/images/gotong_royong.png' },
];

const getBeritaImg = (i: number) => {
  const imgs = ['/images/gotong_royong.png', '/images/pelatihan_umkm.png', '/images/pelatihan_umkm.png', '/images/gotong_royong.png', '/images/kebun_sayur.png', '/images/gotong_royong.png'];
  return imgs[i % imgs.length];
};

const finalBerita = beritaList.length > 0
  ? beritaList.map((b, i) => {
      const cover = covers.get(b.id);
      return { slug: b.slug, judul: b.judul, published_at: b.published_at ?? '', content_html: b.content_html, featured: i === 0, img: cover ? mediaUrl(cover) : getBeritaImg(i) };
    })
  : demoBerita;

const featuredBerita = finalBerita[0];
const restBerita = finalBerita.slice(1);
---

<Layout
  title="Berita | Desa Citarik"
  description="Berita dan pengumuman resmi terbaru dari Pemerintah Desa Citarik, Kecamatan Simpenan, Kabupaten Sukabumi."
>

<div class="container-page py-10 md:py-12">
  <span class="section-label">Informasi desa</span>
  <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-primary mt-2">Berita & Pengumuman</h1>
  <p class="text-muted mt-2 max-w-xl">Kabar terbaru dari Desa Citarik.</p>

  {featuredBerita && (
    <a href={`/berita/${featuredBerita.slug}`}
       class="group grid md:grid-cols-2 gap-0 items-stretch card-surface card-surface-hover overflow-hidden mt-8">
      <div class="aspect-[16/10] md:aspect-auto overflow-hidden min-h-[14rem]">
        {featuredBerita.img ? (
          <img
            src={featuredBerita.img}
            alt={featuredBerita.judul}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="eager"
          />
        ) : (
          <div class="w-full h-full min-h-[200px]" style="background: linear-gradient(135deg, #0E4A6E 0%, #0E9AA7 100%);"></div>
        )}
      </div>
      <div class="p-6 sm:p-8 flex flex-col justify-center">
        <span class="chip chip-potensi w-max">Terbaru</span>
        <time class="text-sm text-muted mt-3">
          {featuredBerita.published_at ? formatTanggal(featuredBerita.published_at) : ''}
        </time>
        <h2 class="font-heading font-extrabold text-2xl text-ink mt-1 group-hover:text-primary transition-colors leading-snug">
          {featuredBerita.judul}
        </h2>
        <p class="text-muted mt-2 line-clamp-3 leading-relaxed">{excerpt(featuredBerita.content_html, 160)}</p>
        <span class="inline-flex items-center gap-1.5 mt-4 text-accent font-heading font-semibold">
          Baca selengkapnya <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </span>
      </div>
    </a>
  )}

  {restBerita.length > 0 && (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
      {restBerita.map(b => (
        <a href={`/berita/${b.slug}`}
           class="group block card-surface card-surface-hover overflow-hidden">
          <div class="aspect-[16/9] overflow-hidden">
            {b.img ? (
              <img src={b.img} alt={b.judul} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            ) : (
              <div class="w-full h-full" style="background: linear-gradient(135deg, #0E4A6E 0%, #0E9AA7 100%);"></div>
            )}
          </div>
          <div class="p-5">
            <time class="text-xs font-heading font-semibold text-muted">
              {b.published_at ? formatTanggal(b.published_at) : ''}
            </time>
            <h3 class="font-heading font-semibold text-ink mt-1.5 group-hover:text-primary transition-colors leading-snug">{b.judul}</h3>
            <p class="text-sm text-muted mt-1.5 line-clamp-2 leading-relaxed">{excerpt(b.content_html, 100)}</p>
          </div>
        </a>
      ))}
    </div>
  )}

  {finalBerita.length === 0 && (
    <div class="empty-state">
      <div class="empty-state__icon">
        <i data-lucide="newspaper" class="w-7 h-7"></i>
      </div>
      <p class="font-heading font-medium text-lg text-muted mt-4">Belum ada berita. Kunjungi lagi nanti.</p>
    </div>
  )}
</div>

</Layout>
