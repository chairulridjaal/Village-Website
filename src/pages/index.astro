---
import Layout from '../components/Layout.astro';
import { getPublishedUmkm } from '../lib/db/umkm';
import { getPublishedBerita, formatTanggal, excerpt } from '../lib/db/berita';
import { getPengaturan } from '../lib/db/pengaturan';
import { getSection } from '../lib/db/page-section';
import { getCoversForType, mediaUrl } from '../lib/db/media';
import { getEnv } from '@lib/env';

const env = getEnv();

const [umkmList, beritaList, s, petaCounts, hero, sekilas, umkmCovers, beritaCovers] = await Promise.all([
  env ? getPublishedUmkm(env.DB) : [],
  env ? getPublishedBerita(env.DB, 3) : [],
  env ? getPengaturan(env.DB) : {},
  env ? env.DB.prepare('SELECT jenis, COUNT(*) AS n FROM titik_peta GROUP BY jenis').all<{ jenis: string; n: number }>() : { results: [] },
  env ? getSection('beranda-hero', env.DB) : null,
  env ? getSection('beranda-sekilas', env.DB) : null,
  env ? getCoversForType('umkm', env.DB) : new Map(),
  env ? getCoversForType('berita', env.DB) : new Map(),
]);

const fmt = (n: number) => n.toLocaleString('id-ID');
const stUmum = JSON.parse(s.stat_umum ?? '{}');
const dusunData: { l: number; p: number }[] = JSON.parse(s.stat_dusun ?? '[]');
const totalPenduduk = dusunData.reduce((sum, d) => sum + d.l + d.p, 0) || Number(stUmum.penduduk) || 0;
const dusunCount = Number(stUmum.dusun) || dusunData.length || 4;
const petaCountByJenis = Object.fromEntries(petaCounts.results.map(r => [r.jenis, r.n]));

const demoBerita = [
  { slug: 'pelatihan-digital-umkm', judul: 'Pelatihan Digital untuk UMKM Desa', published_at: '2026-07-08', img: '/images/pelatihan_umkm.png', ringkasan: 'Sepuluh pelaku UMKM mengikuti pelatihan foto produk dan WhatsApp Business.' },
  { slug: 'peluncuran-situs-resmi', judul: 'Peluncuran Situs Resmi Desa Citarik', published_at: '2026-07-01', img: '/images/pelatihan_umkm.png', ringkasan: 'Desa Citarik kini punya kehadiran digital resmi yang dapat diakses siapa saja.' },
];

const getUmkmImg = (_slug: string) => '/images/kerajinan_bambu.png';

const finalUmkm = umkmList.length > 0
  ? umkmList.slice(0, 4).map(u => {
      const cover = umkmCovers.get(u.id);
      return { slug: u.slug, nama: u.nama, kategori: u.kategori, img: cover ? mediaUrl(cover) : getUmkmImg(u.slug), wa: u.wa_number ?? null, desc: u.deskripsi_html ? excerpt(u.deskripsi_html, 80) : '' };
    })
  : [];

const finalBerita = beritaList.length > 0
  ? beritaList.map(b => {
      const cover = beritaCovers.get(b.id);
      return { slug: b.slug, judul: b.judul, published_at: b.published_at ?? '', img: cover ? mediaUrl(cover) : '/images/gotong_royong.png', ringkasan: excerpt(b.content_html, 120) };
    })
  : demoBerita;
---

<Layout
  title="Desa Citarik - Website Desa"
  description="Situs resmi Pemerintah Desa Citarik, Kecamatan Palabuhanratu, Kabupaten Sukabumi. Profil, potensi, UMKM, dan berita desa."
  transparentNav={true}
>

<section
  class="relative overflow-hidden min-h-[min(78dvh,52rem)]"
  aria-labelledby="hero-heading"
>
  <div
    class="absolute inset-0 bg-cover bg-center"
    style="background-image: url('/images/pantai_Citarik.png');"
    role="img"
    aria-label="Pemandangan Desa Citarik"
  ></div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(10,54,80,0.58) 0%, rgba(10,54,80,0.32) 42%, rgba(10,54,80,0.82) 100%);"
  ></div>

  <div class="relative container-page flex flex-col justify-end min-h-[min(78dvh,52rem)] pb-24 pt-28">
    <span class="inline-flex items-center gap-2 bg-white/12 backdrop-blur-sm text-white text-xs font-heading font-semibold px-3 py-1.5 rounded-full w-max mb-5 border border-white/15">
      <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
      Kecamatan Palabuhanratu
    </span>
    <h1 id="hero-heading" class="font-heading font-extrabold text-white text-4xl sm:text-5xl lg:text-[3.5rem] leading-[1.08] max-w-2xl">
      Selamat Datang di<br/>Desa Citarik
    </h1>
    <div
      class="text-white/85 text-lg mt-4 max-w-xl leading-relaxed"
      set:html={hero?.content_html ?? '<p>Desa Citarik, Kecamatan Palabuhanratu, Kabupaten Sukabumi. Profil resmi mengacu pada isian Prodeskel 2025.</p>'}
    />
    <div class="flex flex-wrap gap-3 mt-8">
      <a href="/profil" class="btn btn-accent">
        <i data-lucide="info" class="w-5 h-5"></i> Profil Desa
      </a>
      <a href="/peta" class="btn btn-ghost">
        <i data-lucide="map" class="w-5 h-5"></i> Lihat Peta
      </a>
    </div>
  </div>
</section>

<section class="relative z-20 -mt-14 sm:-mt-16">
  <div class="container-page">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      {[
        { href: '/potensi', label: 'Potensi', img: '/images/kebun_sayur.png' },
        { href: '/umkm', label: 'UMKM', img: '/images/tile_umkm.png' },
        { href: '/peta', label: 'Peta Desa', img: '/images/tile_peta.png' },
        { href: '/berita', label: 'Berita', img: '/images/tile_berita.png' },
      ].map(tile => (
        <a
          href={tile.href}
          class="group relative block rounded-xl overflow-hidden h-40 sm:h-52 border border-white/20 shadow-md hover:shadow-lg transition-shadow"
        >
          <img
            src={tile.img}
            alt={tile.label}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0A3650]/92 via-[#0A3650]/25 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-200"></div>
          <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5 flex items-center justify-between text-white">
            <span class="font-heading font-bold text-lg sm:text-xl tracking-tight">{tile.label}</span>
            <i data-lucide="arrow-right" class="w-5 h-5 opacity-80 group-hover:translate-x-1 transition-transform duration-200"></i>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="container-page pt-20 pb-8 text-center" aria-labelledby="welcome-heading">
  <span class="section-label">Selamat Datang di Desa Citarik</span>
  <h2 id="welcome-heading" class="text-3xl sm:text-4xl font-heading font-extrabold text-primary mt-3 max-w-2xl mx-auto leading-tight">
    {sekilas?.title ?? 'Desa Citarik, Kecamatan Palabuhanratu'}
  </h2>
  <div
    class="text-muted text-lg mt-5 max-w-2xl mx-auto leading-relaxed"
    set:html={sekilas?.content_html ?? `<p>Desa Citarik di Kecamatan Palabuhanratu, Kabupaten Sukabumi, dihuni sekitar ${fmt(totalPenduduk)} jiwa di ${dusunCount} dusun (Prodeskel 2025).</p>`}
  />
</section>

<section class="py-12 md:py-16" aria-labelledby="potensi-heading">
  <div class="container-page">
    <div class="flex items-end justify-between mb-8 gap-4">
      <div>
        <span class="section-label">Potensi</span>
        <h2 id="potensi-heading" class="font-heading font-extrabold text-2xl sm:text-3xl text-primary mt-1">Sektor Unggulan Desa</h2>
      </div>
      <a href="/potensi" class="hidden sm:inline-flex items-center gap-1.5 text-primary font-heading font-semibold hover:text-accent transition-colors">
        Semua potensi <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
    </div>
    <div class="grid sm:grid-cols-3 gap-5">
      {[
        { href: '/potensi/pertanian', title: 'Pertanian', desc: '773 keluarga petani, 2.330 Ha sawah, padi & pisang (Prodeskel 2025).', img: '/images/kebun_sayur.png', icon: 'wheat' },
        { href: '/potensi/perikanan', title: 'Perikanan', desc: 'Empang/kolam, pancing, produksi mas & nila skala lokal.', img: '/images/ikan_bakar.png', icon: 'fish' },
        { href: '/potensi/sdm', title: 'SDM', desc: '8.553 pekerja usia 18–56 thn, BPD, LPMD, BUMDes, 10 RW / 50 RT.', img: '/images/nelayan.png', icon: 'users' },
      ].map(item => (
        <a href={item.href} class="group block card-surface card-surface-hover overflow-hidden">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={item.img} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-5">
            <i data-lucide={item.icon} class="w-5 h-5 text-accent"></i>
            <h3 class="font-heading font-bold text-lg text-ink mt-2 group-hover:text-primary transition-colors">{item.title}</h3>
            <p class="text-sm text-muted mt-1.5 leading-relaxed">{item.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="py-14 md:py-18 relative overflow-hidden" style="background-color: var(--color-primary-dark);" aria-labelledby="umkm-heading">
  <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 20% 20%, #0E9AA7 0%, transparent 45%), radial-gradient(circle at 80% 80%, #15803D 0%, transparent 40%);"></div>
  <div class="relative container-page">
    <div class="flex items-end justify-between mb-8 gap-4">
      <div>
        <span class="section-label !text-accent">Produk Lokal</span>
        <h2 id="umkm-heading" class="font-heading font-extrabold text-2xl sm:text-3xl text-white mt-1">UMKM Unggulan</h2>
      </div>
      <a href="/umkm" class="text-sm font-heading font-semibold text-accent hover:text-white flex items-center gap-1 transition-colors shrink-0">
        Lihat Semua <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
    </div>

    {finalUmkm.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {finalUmkm.map(u => (
          <article class="bg-white/[0.07] backdrop-blur-sm rounded-xl overflow-hidden border border-white/10 flex flex-col">
            <a href={`/umkm/${u.slug}`} class="block aspect-[16/10] overflow-hidden relative">
              {u.img ? (
                <img src={u.img} alt={u.nama} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="w-full h-full" style="background: linear-gradient(135deg, #0E9AA7, #15803D);"></div>
              )}
            </a>
            <div class="p-4 flex flex-col flex-1">
              <span class="text-xs font-heading font-semibold text-accent">{u.kategori}</span>
              <h3 class="font-heading font-semibold text-white mt-1">
                <a href={`/umkm/${u.slug}`} class="hover:text-accent transition-colors">{u.nama}</a>
              </h3>
              <p class="text-white/60 text-sm mt-1 flex-1 line-clamp-2">{u.desc}</p>
              {u.wa ? (
                <a href={`https://wa.me/${u.wa}`} target="_blank" rel="noopener noreferrer" class="mt-3 btn btn-cta w-full text-sm py-2.5">
                  <i data-lucide="message-circle" class="w-4 h-4"></i> WhatsApp
                </a>
              ) : (
                <a href={`/umkm/${u.slug}`} class="mt-3 btn btn-ghost w-full text-sm py-2.5">Lihat Detail</a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-white/15 bg-white/[0.05] px-6 py-12 text-center">
        <div class="w-12 h-12 mx-auto rounded-full bg-white/10 grid place-items-center mb-4">
          <i data-lucide="store" class="w-6 h-6 text-accent"></i>
        </div>
        <h3 class="font-heading font-semibold text-white text-lg">Direktori UMKM sedang diisi</h3>
        <p class="text-white/65 mt-2 max-w-md mx-auto text-sm leading-relaxed">
          Pendataan pelaku usaha desa dilakukan lewat panel admin. Data binaan dan daftar usaha baru tersedia sebagai referensi di repositori.
        </p>
        <a href="/umkm" class="btn btn-accent mt-6">Buka Direktori UMKM</a>
      </div>
    )}
  </div>
</section>

<section class="relative py-16 md:py-24 overflow-hidden" aria-labelledby="peta-heading">
  <div class="absolute inset-0">
    <img src="/images/pantai_Citarik.png" alt="" class="w-full h-full object-cover" aria-hidden="true" loading="lazy" />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(10,54,80,0.94) 0%, rgba(10,54,80,0.78) 55%, rgba(10,54,80,0.55) 100%);"></div>
  </div>
  <div class="relative container-page">
    <div class="max-w-xl text-white">
      <span class="section-label !text-accent">Peta Desa</span>
      <h2 id="peta-heading" class="font-heading font-extrabold text-3xl sm:text-4xl mt-2 text-white">Temukan Lokasi di Citarik</h2>
      <p class="text-white/80 mt-4 leading-relaxed">
        Jelajahi peta interaktif Desa Citarik: titik UMKM dan potensi desa ditandai di peta. Klik penanda untuk detail.
      </p>
      <div class="flex flex-wrap gap-5 mt-6">
        {[
          { icon: 'store', label: `${petaCountByJenis.umkm ?? 0} UMKM`, color: '#15803D' },
          { icon: 'sprout', label: `${petaCountByJenis.potensi ?? 0} Potensi`, color: '#F4EBDD' },
        ].map(item => (
          <span class="flex items-center gap-2 text-sm text-white/85">
            <i data-lucide={item.icon} class="w-4 h-4" style={`color:${item.color}`}></i>
            {item.label}
          </span>
        ))}
      </div>
      <a href="/peta" class="btn btn-accent mt-8">
        <i data-lucide="map" class="w-5 h-5"></i> Buka Peta Interaktif
      </a>
    </div>
  </div>
</section>

<section class="py-14 md:py-18" aria-labelledby="berita-heading">
  <div class="container-page">
    <div class="flex items-end justify-between mb-8 gap-4">
      <div>
        <span class="section-label">Informasi</span>
        <h2 id="berita-heading" class="font-heading font-extrabold text-2xl sm:text-3xl text-ink mt-1">Berita & Pengumuman</h2>
      </div>
      <a href="/berita" class="text-sm font-heading font-semibold text-accent hover:text-primary flex items-center gap-1 transition-colors shrink-0">
        Semua Berita <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {finalBerita.map(b => (
        <a href={`/berita/${b.slug}`} class="group block card-surface card-surface-hover overflow-hidden">
          <div class="aspect-[16/9] overflow-hidden">
            {b.img ? (
              <img src={b.img} alt={b.judul} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            ) : (
              <div class="w-full h-full" style="background: linear-gradient(135deg, #0E4A6E 0%, #0E9AA7 100%);"></div>
            )}
          </div>
          <div class="p-5">
            <time class="text-xs font-heading font-semibold text-muted">
              {b.published_at ? formatTanggal(b.published_at) : ''}
            </time>
            <h3 class="font-heading font-semibold text-ink mt-1.5 group-hover:text-primary transition-colors leading-snug">{b.judul}</h3>
            <p class="text-sm text-muted mt-1.5 line-clamp-2 leading-relaxed">{b.ringkasan}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

</Layout>
