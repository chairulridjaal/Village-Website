---
import AdminLayout from '../../../components/AdminLayout.astro';

const inputCls = 'w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none';
const inputStyle = 'border-color:var(--color-border); min-height:44px;';
---

<AdminLayout title="Tambah Potensi" breadcrumb="Potensi / Baru">

  <form method="POST" action="/api/admin/potensi" class="max-w-3xl space-y-5">
    <div>
      <label class="block font-heading font-medium text-sm mb-1.5" for="nama">Nama *</label>
      <input id="nama" name="nama" required class={inputCls} style={inputStyle} />
    </div>
    <div>
      <label class="block font-heading font-medium text-sm mb-1.5" for="ringkasan">Ringkasan (kartu hub)</label>
      <textarea id="ringkasan" name="ringkasan" rows="3" class={inputCls} style={inputStyle}></textarea>
    </div>
    <div>
      <label class="block font-heading font-medium text-sm mb-1.5" for="deskripsi_html">Isi halaman (HTML sederhana)</label>
      <textarea id="deskripsi_html" name="deskripsi_html" rows="10" class={inputCls} style={inputStyle}></textarea>
      <p class="text-xs text-text-muted mt-1">Boleh pakai &lt;p&gt;, &lt;strong&gt;, &lt;ul&gt;, &lt;h2&gt;. Editor TipTap menyusul.</p>
    </div>
    <div>
      <label class="block font-heading font-medium text-sm mb-1.5" for="stats_json">Kartu angka (JSON opsional)</label>
      <textarea id="stats_json" name="stats_json" rows="3" class={inputCls} style={inputStyle} placeholder='[{"icon":"users","label":"Petani","value":"773"}]'></textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block font-heading font-medium text-sm mb-1.5" for="urutan">Urutan</label>
        <input type="number" id="urutan" name="urutan" value="100" class={inputCls} style={inputStyle} />
      </div>
      <div>
        <label class="block font-heading font-medium text-sm mb-1.5" for="status">Status</label>
        <select id="status" name="status" class={inputCls} style={inputStyle}>
          <option value="draft">Draf</option>
          <option value="published">Terbit</option>
        </select>
      </div>
    </div>
    <div class="flex gap-3">
      <a href="/admin/potensi" class="px-4 py-2 rounded-lg border text-sm font-heading" style="border-color:var(--color-border);">Batal</a>
      <button type="submit" class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm" style="background:var(--color-cta);">Simpan</button>
    </div>
  </form>

</AdminLayout>
