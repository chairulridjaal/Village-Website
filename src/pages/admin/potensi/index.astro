---
import AdminLayout from '../../../components/AdminLayout.astro';
import { getAllPotensi } from '../../../lib/db/potensi';
import { getEnv } from '@lib/env';

const env = getEnv();
const list = env ? await getAllPotensi(env.DB) : [];
const saved = Astro.url.searchParams.get('saved');
const search = Astro.url.searchParams.get('q') ?? '';
const filtered = list.filter(p => !search || p.nama.toLowerCase().includes(search.toLowerCase()));
---

<AdminLayout title="Potensi" breadcrumb="Potensi">

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5;color:#065F46;border:1px solid #6EE7B7;">
      Potensi disimpan.
    </div>
  )}

  <form method="GET" class="flex flex-wrap gap-3 mb-4">
    <input type="text" name="q" value={search} placeholder="Cari potensi..." class="rounded-lg border px-4 py-2 text-sm focus:outline-none flex-1 min-w-48" style="border-color:var(--color-border); min-height:44px;" />
    <button type="submit" class="px-4 py-2 rounded-lg font-heading font-medium text-sm border hover:bg-sand cursor-pointer" style="border-color:var(--color-border); min-height:44px;">Cari</button>
    {search && <a href="/admin/potensi" class="px-4 py-2 rounded-lg text-sm border hover:bg-sand inline-flex items-center" style="border-color:var(--color-border); min-height:44px;">Reset</a>}
  </form>

  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="font-heading font-bold text-xl" style="color:var(--color-primary);">Potensi Desa</h2>
      <p class="text-sm text-text-muted mt-1">Tambah halaman potensi baru. Hanya yang berstatus Terbit yang tampil di publik.</p>
    </div>
    <a href="/admin/potensi/new" class="px-4 py-2 rounded-lg font-heading font-semibold text-white text-sm" style="background:var(--color-cta);min-height:44px;display:inline-flex;align-items:center;">
      + Tambah potensi
    </a>
  </div>

  <div class="bg-white rounded-xl border border-border overflow-hidden" style="box-shadow:var(--shadow-sm);">
    {filtered.length === 0 ? (
      <p class="p-8 text-center text-text-muted">{list.length === 0 ? 'Belum ada potensi.' : 'Tidak ada potensi yang sesuai.'}</p>
    ) : (
      <table class="w-full text-sm">
        <thead style="background:#F8FAFC;">
          <tr class="border-b border-border">
            <th class="text-left px-4 py-3 font-heading font-semibold">Nama</th>
            <th class="text-left px-4 py-3 font-heading font-semibold hidden sm:table-cell">Status</th>
            <th class="text-left px-4 py-3 font-heading font-semibold hidden md:table-cell">Urutan</th>
            <th class="px-4 py-3 font-heading font-semibold">Aksi</th>
          </tr>
        </thead>
        <tbody>
          {filtered.map((p) => (
            <tr class="border-b border-border last:border-0 hover:bg-sand/30">
              <td class="px-4 py-3 font-medium">{p.nama}<div class="text-xs text-text-muted">/{p.slug}</div></td>
              <td class="px-4 py-3 hidden sm:table-cell capitalize">{p.status}</td>
              <td class="px-4 py-3 hidden md:table-cell">{p.urutan}</td>
              <td class="px-4 py-3 text-center">
                <div class="inline-flex items-center gap-2">
                  <a href={`/admin/potensi/${p.id}`} class="inline-block px-3 py-1.5 rounded-md font-heading font-medium text-xs border" style="border-color:var(--color-primary);color:var(--color-primary);">Sunting</a>
                  <form method="POST" action={`/api/admin/potensi/${p.id}`} onsubmit="return confirm('Hapus potensi &quot;'+this.dataset.nama+'&quot;? Tindakan tidak dapat dibatalkan.')">
                    <input type="hidden" name="_action" value="delete" />
                    <button type="submit" data-nama={p.nama} aria-label={`Hapus potensi ${p.nama}`} class="px-3 py-1.5 rounded-md font-heading font-medium text-xs border text-red-600 hover:bg-red-50" style="border-color:#FCA5A5; min-height:32px;">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

</AdminLayout>
