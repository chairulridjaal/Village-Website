---
import AdminLayout from '../../components/AdminLayout.astro';
import { getPengumumanBanner } from '../../lib/db/pengumuman';
import { getEnv } from '@lib/env';

const env = getEnv();
const banner = env ? await getPengumumanBanner(env.DB) : null;
const saved = Astro.url.searchParams.get('saved');
const off = Astro.url.searchParams.get('off');
const error = Astro.url.searchParams.get('error');

const teks = banner?.teks ?? '';
const style = banner?.style ?? 'info';
const aktif = banner ? !!banner.aktif : false;
const tautan_url = banner?.tautan_url ?? '';
const tautan_label = banner?.tautan_label ?? '';
const endsAt = banner?.ends_at ?? null;

let expireMode = 'manual';
let endsDate = '';
if (endsAt) {
  expireMode = 'date';
  endsDate = endsAt.slice(0, 10);
  const ms = Date.parse(endsAt) - Date.now();
  const days = ms / (86400000);
  if (days > 5.5 && days < 8.5) expireMode = '7';
  if (days > 27 && days < 33) expireMode = '30';
}

const expired =
  endsAt && !Number.isNaN(Date.parse(endsAt)) && Date.parse(endsAt) <= Date.now();
---

<AdminLayout title="Banner Pengumuman" breadcrumb="Pengumuman">

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5;color:#065F46;border:1px solid #6EE7B7;">
      Pengumuman disimpan. Banner muncul di beranda jika status aktif.
    </div>
  )}
  {off && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#E0F2FE;color:#075985;border:1px solid #7DD3FC;">
      Banner dimatikan.
    </div>
  )}
  {error === 'teks' && (
    <div role="alert" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;">
      Teks pengumuman wajib diisi.
    </div>
  )}

  <div class="max-w-2xl">
    <h2 class="font-heading font-bold text-xl mb-2" style="color:var(--color-primary);">Banner pengumuman beranda</h2>
    <p class="text-sm text-text-muted mb-6 leading-relaxed">
      Muncul di atas navigasi <strong>hanya di halaman beranda</strong>. Bisa otomatis hilang setelah 7 hari, 30 hari, tanggal tertentu, atau dimatikan manual.
    </p>

    {expired && aktif && (
      <div class="mb-4 p-3 rounded-lg text-sm" style="background:#FEF3C7;color:#92400E;border:1px solid #FCD34D;">
        Jadwal berakhir sudah lewat — banner tidak ditampilkan di beranda meski status masih aktif. Perbarui jadwal atau matikan.
      </div>
    )}

    <form method="POST" action="/api/admin/pengumuman" class="space-y-5 bg-white rounded-xl border border-border p-5 md:p-6" style="box-shadow:var(--shadow-sm);">
      <div>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="aktif" value="1" checked={aktif} class="w-5 h-5 rounded border" />
          <span class="font-heading font-medium text-sm">Tampilkan banner di beranda</span>
        </label>
      </div>

      <div>
        <label for="teks" class="block font-heading font-medium text-sm mb-1.5">Teks pengumuman <span class="text-red-600">*</span></label>
        <textarea id="teks" name="teks" rows="3" required maxlength="500"
          class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
          style="border-color:var(--color-border);"
          placeholder="Contoh: Posyandu balita digeser ke Sabtu, 2 Agustus 2026 pukul 08.00 di Balai Desa.">{teks}</textarea>
        <p class="text-xs text-text-muted mt-1">Maks. 500 karakter. Singkat dan jelas.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="style" class="block font-heading font-medium text-sm mb-1.5">Warna / jenis</label>
          <select id="style" name="style" class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;">
            <option value="info" selected={style === 'info'}>Info (biru)</option>
            <option value="success" selected={style === 'success'}>Sukses (hijau)</option>
            <option value="warning" selected={style === 'warning'}>Peringatan (kuning)</option>
            <option value="urgent" selected={style === 'urgent'}>Penting (merah)</option>
          </select>
        </div>
        <div>
          <label for="expire_mode" class="block font-heading font-medium text-sm mb-1.5">Berakhir otomatis</label>
          <select id="expire_mode" name="expire_mode" class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;">
            <option value="manual" selected={expireMode === 'manual'}>Hingga dimatikan manual</option>
            <option value="7" selected={expireMode === '7'}>7 hari dari sekarang</option>
            <option value="30" selected={expireMode === '30'}>30 hari dari sekarang</option>
            <option value="date" selected={expireMode === 'date'}>Sampai tanggal tertentu</option>
          </select>
        </div>
      </div>

      <div id="date-wrap" class:list={['', expireMode !== 'date' && 'hidden']}>
        <label for="ends_at_date" class="block font-heading font-medium text-sm mb-1.5">Tanggal berakhir</label>
        <input type="date" id="ends_at_date" name="ends_at_date" value={endsDate}
          class="w-full sm:w-56 rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
        <p class="text-xs text-text-muted mt-1">Banner hilang setelah tanggal ini (akhir hari).</p>
      </div>

      <fieldset class="border border-border rounded-xl p-4">
        <legend class="font-heading font-semibold text-sm px-2" style="color:var(--color-primary);">Tautan (opsional)</legend>
        <div class="space-y-3 mt-1">
          <div>
            <label for="tautan_url" class="block text-sm mb-1">URL</label>
            <input type="text" id="tautan_url" name="tautan_url" value={tautan_url}
              placeholder="https://… atau /berita/…"
              class="w-full rounded-lg border px-4 py-2.5 text-base" style="border-color:var(--color-border); min-height:44px;" />
          </div>
          <div>
            <label for="tautan_label" class="block text-sm mb-1">Teks tombol</label>
            <input type="text" id="tautan_label" name="tautan_label" value={tautan_label}
              placeholder="Selengkapnya"
              class="w-full rounded-lg border px-4 py-2.5 text-base" style="border-color:var(--color-border); min-height:44px;" />
          </div>
        </div>
      </fieldset>

      <div class="flex flex-wrap gap-3 justify-end pt-2 border-t border-border">
        <button type="submit" name="_action" value="off"
          class="px-4 py-2 rounded-lg font-heading font-medium text-sm border cursor-pointer"
          style="border-color:var(--color-border); min-height:44px;">
          Matikan banner
        </button>
        <button type="submit" name="_action" value="save"
          class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer"
          style="background:var(--color-cta); min-height:44px;">
          Simpan &amp; bagikan
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const mode = document.getElementById('expire_mode') as HTMLSelectElement | null;
  const wrap = document.getElementById('date-wrap');
  mode?.addEventListener('change', () => {
    if (!wrap) return;
    if (mode.value === 'date') wrap.classList.remove('hidden');
    else wrap.classList.add('hidden');
  });
</script>
