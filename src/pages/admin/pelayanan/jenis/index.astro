---
import AdminLayout from '../../../../components/AdminLayout.astro';
import { getAllJenis } from '../../../../lib/db/pelayanan';
import { getEnv } from '@lib/env';

const env = getEnv();
const list = env ? await getAllJenis(env.DB) : [];
const saved = Astro.url.searchParams.get('saved');
---

<AdminLayout title="Jenis Surat" breadcrumb="Pelayanan / Jenis surat">

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5;color:#065F46;border:1px solid #6EE7B7;">
      Jenis surat disimpan.
    </div>
  )}

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <div>
      <h2 class="font-heading font-bold text-xl" style="color:var(--color-primary);">Jenis surat</h2>
      <p class="text-sm text-text-muted mt-0.5">Katalog layanan + template yang tampil di /pelayanan</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/admin/pelayanan"
        class="px-4 py-2 rounded-lg font-heading font-medium text-sm border"
        style="border-color:var(--color-border);min-height:44px;display:flex;align-items:center;">
        Lihat pengajuan
      </a>
      <a href="/admin/pelayanan/jenis/new"
        class="px-4 py-2 rounded-lg font-heading font-semibold text-sm text-white"
        style="background:var(--color-cta);min-height:44px;display:flex;align-items:center;">
        + Tambah jenis
      </a>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-border overflow-hidden" style="box-shadow:var(--shadow-sm);">
    {list.length === 0 ? (
      <div class="p-8 text-center text-text-muted">Belum ada jenis surat. Tambahkan yang pertama.</div>
    ) : (
      <table class="w-full text-sm">
        <thead style="background:#F8FAFC;">
          <tr class="border-b border-border">
            <th class="text-left px-4 py-3 font-heading font-semibold">Nama</th>
            <th class="text-left px-4 py-3 font-heading font-semibold hidden md:table-cell">Slug</th>
            <th class="text-left px-4 py-3 font-heading font-semibold">Status</th>
            <th class="text-right px-4 py-3 font-heading font-semibold">Urutan</th>
            <th class="px-4 py-3 font-heading font-semibold">Aksi</th>
          </tr>
        </thead>
        <tbody>
          {list.map(j => (
            <tr class="border-b border-border last:border-0 hover:bg-sand/30">
              <td class="px-4 py-3 font-medium">{j.nama}</td>
              <td class="px-4 py-3 text-text-muted hidden md:table-cell">{j.slug}</td>
              <td class="px-4 py-3">
                {j.aktif
                  ? <span class="text-xs font-heading font-semibold px-2 py-1 rounded-full" style="background:#D1FAE5;color:#065F46;">Aktif</span>
                  : <span class="text-xs font-heading font-semibold px-2 py-1 rounded-full" style="background:#F1F5F9;color:#64748B;">Nonaktif</span>}
              </td>
              <td class="px-4 py-3 text-right tabular-nums">{j.urutan}</td>
              <td class="px-4 py-3 text-center">
                <a href={`/admin/pelayanan/jenis/${j.id}`}
                  class="inline-block px-3 py-1.5 rounded-md font-heading font-medium text-xs border"
                  style="border-color:var(--color-primary);color:var(--color-primary);">
                  Sunting
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

</AdminLayout>
