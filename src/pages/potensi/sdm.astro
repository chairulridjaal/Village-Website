---
import Layout from '../../components/Layout.astro';

const fmt = (n: number) => n.toLocaleString('id-ID');

const organisasi = [
  { icon: 'landmark', nama: 'Badan Permusyawaratan Desa (BPD)', desc: '9 anggota (rekap BPD Juni 2025), menetapkan peraturan desa bersama Kepala Desa.' },
  { icon: 'handshake', nama: 'LPMD', desc: '1 lembaga · 12 pengurus (Prodeskel). Mendampingi perencanaan dan pelaksanaan pembangunan desa.' },
  { icon: 'briefcase', nama: 'BUMDes', desc: '1 unit usaha desa (Prodeskel) untuk pengelolaan potensi ekonomi lokal.' },
  { icon: 'home', nama: 'Rukun Warga (RW)', desc: '10 RW dengan pengurus di tingkat wilayah.' },
  { icon: 'users', nama: 'Rukun Tetangga (RT)', desc: '50 RT sebagai ujung tombak pelayanan warga.' },
  { icon: 'map', nama: 'Kepala Dusun', desc: '4 dusun, masing-masing dipimpin kepala dusun aktif.' },
];

const prasarana = [
  { icon: 'users', label: 'Dusun', value: '4' },
  { icon: 'home', label: 'RW / RT', value: '10 / 50' },
  { icon: 'landmark', label: 'Anggota BPD', value: '9 orang' },
  { icon: 'briefcase', label: 'BUMDes', value: '1 unit' },
  { icon: 'handshake', label: 'LPMD', value: '1 · 12 pengurus' },
  { icon: 'building', label: 'Aparat desa', value: '12 orang' },
];
---

<Layout
  title="Potensi Sumber Daya Manusia | Desa Citarik"
  description="Potensi SDM Desa Citarik: kelembagaan, tenaga kerja, RW/RT, BPD, LPMD, dan BUMDes (Prodeskel 2025)."
>

<section class="page-hero">
  <div class="page-hero__media">
    <img src="/images/nelayan.png" alt="Warga dan organisasi masyarakat Desa Citarik" />
  </div>
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content">
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Beranda</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <a href="/potensi">Potensi</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <span class="font-medium text-white">SDM</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold mt-1.5">Sumber Daya Manusia</h1>
    </div>
  </div>
</section>

<div class="container-page py-10 space-y-12">
  <p class="text-lg text-muted leading-relaxed max-w-3xl">
    Data kelembagaan dan tenaga kerja merujuk Prodeskel Maret 2025 serta rekap PEMDES/BPD Juni 2025. Penduduk usia 18–56 tahun yang bekerja tercatat {fmt(8553)} orang (laki-laki {fmt(4609)}, perempuan {fmt(3944)}).
  </p>

  <div class="grid sm:grid-cols-3 gap-4">
    {[
      { icon: 'briefcase', label: 'Usia 18–56 thn bekerja', value: fmt(8553) },
      { icon: 'users', label: 'Kepala keluarga', value: fmt(4220) },
      { icon: 'user-check', label: 'Penduduk total', value: fmt(13187) },
    ].map(item => (
      <div class="card-surface p-5 text-center">
        <i data-lucide={item.icon} class="w-8 h-8 text-accent mx-auto"></i>
        <p class="font-heading font-extrabold text-2xl text-primary mt-2">{item.value}</p>
        <p class="text-sm text-muted mt-0.5">{item.label}</p>
      </div>
    ))}
  </div>

  <section>
    <h2 class="text-2xl font-heading font-extrabold text-primary">Kelembagaan</h2>
    <div class="grid sm:grid-cols-2 gap-4 mt-6">
      {organisasi.map(o => (
        <div class="card-surface p-5">
          <i data-lucide={o.icon} class="w-6 h-6 text-accent"></i>
          <h3 class="font-heading font-bold text-ink mt-2">{o.nama}</h3>
          <p class="text-sm text-muted mt-1 leading-relaxed">{o.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-heading font-extrabold text-primary">Ringkasan wilayah & lembaga</h2>
    <div class="grid sm:grid-cols-3 gap-4 mt-6">
      {prasarana.map(item => (
        <div class="card-surface p-5 text-center">
          <i data-lucide={item.icon} class="w-7 h-7 text-cta mx-auto"></i>
          <p class="font-heading font-extrabold text-xl text-primary mt-2">{item.value}</p>
          <p class="text-sm text-muted mt-0.5">{item.label}</p>
        </div>
      ))}
    </div>
  </section>
</div>

</Layout>
