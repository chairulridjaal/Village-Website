---
import Layout from '../../components/Layout.astro';
import { getPengaturan } from '../../lib/db/pengaturan';
import { waPelayananLink } from '../../lib/wa';
import { getEnv } from '@lib/env';

const nomor = Astro.url.searchParams.get('nomor') ?? '';
const env = getEnv();
const s = env ? await getPengaturan(env.DB) : {};
const waHref = waPelayananLink(s.wa_pelayanan, nomor);
---

<Layout title="Pengajuan Terkirim | Desa Citarik" description="Pengajuan pelayanan desa berhasil dikirim.">

<div class="container-page py-16 max-w-lg mx-auto text-center">
  <div class="w-16 h-16 mx-auto rounded-full grid place-items-center mb-5" style="background:#D1FAE5;color:#065F46;">
    <i data-lucide="check" class="w-8 h-8"></i>
  </div>
  <h1 class="text-2xl sm:text-3xl font-heading font-extrabold text-primary">Pengajuan terkirim</h1>
  <p class="text-muted mt-3 leading-relaxed">
    Data Anda sudah masuk antrean petugas desa. Simpan nomor pengajuan berikut.
  </p>
  {nomor && (
    <p class="mt-6 font-heading font-bold text-2xl text-ink tracking-wide tabular-nums border border-border rounded-xl py-4 px-6 bg-white">
      {nomor}
    </p>
  )}
  <p class="text-sm text-muted mt-4 leading-relaxed">
    Disarankan chat petugas lewat WhatsApp agar proses lebih cepat. Anda juga bisa cek status kapan saja dengan nomor ini + WA.
  </p>

  {waHref ? (
    <a href={waHref} target="_blank" rel="noopener noreferrer"
      class="mt-6 w-full inline-flex items-center justify-center gap-2 rounded-xl font-heading font-bold text-white text-base py-4 px-6"
      style="background:#25D366;min-height:52px;box-shadow:0 4px 14px rgba(37,211,102,.35);">
      <i data-lucide="message-circle" class="w-5 h-5"></i>
      Chat petugas via WhatsApp
    </a>
  ) : (
    <p class="mt-6 text-sm text-muted border border-border rounded-xl p-4 bg-white">
      Nomor WhatsApp petugas belum diset. Silakan hubungi kantor desa lewat halaman
      <a href="/kontak" class="text-accent font-semibold hover:underline">Kontak</a>.
    </p>
  )}

  <div class="flex flex-wrap gap-3 justify-center mt-8">
    {nomor && (
      <a href={`/pelayanan/status?nomor=${encodeURIComponent(nomor)}`} class="btn btn-primary">
        Cek status
      </a>
    )}
    <a href="/pelayanan" class="btn btn-secondary">Ajukan lagi</a>
    <a href="/" class="btn btn-secondary">Ke beranda</a>
  </div>
</div>

</Layout>
