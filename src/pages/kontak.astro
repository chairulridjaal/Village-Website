---
import Layout from '../components/Layout.astro';
import { getPengaturan } from '../lib/db/pengaturan';
import { getEnv } from '@lib/env';

const env = getEnv();
const s = env ? await getPengaturan(env.DB) : {};

const kanal = [
  { key: 'sosial_whatsapp', label: 'WhatsApp resmi desa', icon: 'message-circle', text: 'WhatsApp',
    cls: 'btn btn-cta' },
  { key: 'sosial_facebook', label: 'Facebook resmi desa', icon: 'facebook', text: 'Facebook',
    cls: 'btn btn-secondary' },
  { key: 'sosial_instagram', label: 'Instagram resmi desa', icon: 'instagram', text: 'Instagram',
    cls: 'btn btn-secondary' },
].filter(x => s[x.key]);
---

<Layout
  title="Kontak & Info | Desa Citarik"
  description="Alamat, telepon, email, dan kanal resmi Pemerintah Desa Citarik, Kecamatan Palabuhanratu, Kabupaten Sukabumi."
>

<div class="container-page py-10 md:py-12">
  <span class="section-label">Hubungi kami</span>
  <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-primary mt-2">Kontak & Info Desa</h1>
  <p class="text-muted mt-2 max-w-xl leading-relaxed">Hubungi Pemerintah Desa Citarik melalui kanal resmi berikut.</p>

  <div class="grid lg:grid-cols-2 gap-6 mt-8">
    <div class="space-y-4">
      {[
        { icon: 'map-pin', title: 'Alamat Kantor', content: s.kontak_alamat },
        { icon: 'phone', title: 'Telepon', content: s.kontak_telepon },
        { icon: 'mail', title: 'Email', content: s.kontak_email },
        { icon: 'clock', title: 'Jam Layanan', content: s.kontak_jam },
      ].map(item => (
        <div class="card-surface p-5 flex gap-4">
          <span class="w-11 h-11 rounded-full bg-sand grid place-items-center text-primary shrink-0">
            <i data-lucide={item.icon} class="w-5 h-5"></i>
          </span>
          <div>
            <h2 class="font-heading font-semibold text-ink">{item.title}</h2>
            <p class="text-muted mt-0.5 leading-relaxed">{item.content}</p>
          </div>
        </div>
      ))}

      {kanal.length > 0 && (
        <div class="card-surface p-5">
          <h2 class="font-heading font-semibold text-ink">Kanal Resmi</h2>
          <div class="flex flex-wrap gap-3 mt-3">
            {kanal.map(item => (
              <a href={s[item.key]} target="_blank" rel="noopener noreferrer" aria-label={item.label}
                 class={item.cls}>
                <i data-lucide={item.icon} class="w-5 h-5"></i> {item.text}
              </a>
            ))}
          </div>
          <p class="text-xs text-muted mt-3 leading-relaxed">Tidak ada formulir kontak di situs ini. Silakan hubungi kami langsung lewat kanal di atas.</p>
        </div>
      )}
    </div>

    <div class="relative rounded-xl overflow-hidden border border-border shadow-sm min-h-[20rem]">
      <div id="kontak-map" data-lat={s.map_lat ?? '-7.009933224557312'} data-lng={s.map_lng ?? '106.58103748650889'} data-zoom={s.map_zoom ?? '15'} class="w-full h-full absolute inset-0"></div>
      <a href="/peta"
         class="absolute bottom-4 right-4 btn btn-primary z-10 shadow-md">
        <i data-lucide="map" class="w-5 h-5"></i> Buka Peta Desa
      </a>
    </div>
  </div>
</div>

</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var map = L.map('kontak-map', { scrollWheelZoom: false }).setView([Number(document.getElementById('kontak-map').dataset.lat)||-7.009933224557312, Number(document.getElementById('kontak-map').dataset.lng)||106.58103748650889], Number(document.getElementById('kontak-map').dataset.zoom)||15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: 'Â© OpenStreetMap' }).addTo(map);
    L.marker([Number(document.getElementById('kontak-map').dataset.lat)||-7.009933224557312, Number(document.getElementById('kontak-map').dataset.lng)||106.58103748650889]).addTo(map).bindPopup('<b>Kantor Desa Citarik</b><br>Kp. Legok Loa Â· Kec. Palabuhanratu');
    if (typeof window.refreshIcons === 'function') window.refreshIcons();
  });
</script>
