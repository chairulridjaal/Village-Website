---
import Layout from '../components/Layout.astro';
import { getPublishedPotensi } from '../lib/db/potensi';
import { getCoversForType, mediaUrl } from '../lib/db/media';
import { getEnv } from '@lib/env';

const env = getEnv();
const list = env ? await getPublishedPotensi(env.DB).catch(() => []) : [];
const covers = env ? await getCoversForType('potensi', env.DB).catch(() => new Map()) : new Map();

	const FALLBACK = {
	  perikanan: '/images/pempek-ikan-tuna.jpg',
	  pertanian: '/images/pemandangan_citarik.png',
	  sdm: '/images/tile_berita_baru.jpg',
	} as Record<string, string>;
	---
	
	<Layout
	  title="Potensi Desa | Desa Citarik"
	  description="Potensi Desa Citarik: pertanian, perikanan, sumber daya manusia, dan peluang kemitraan."
	>
	
	<section class="page-hero">
	  <div class="page-hero__media">
	    <img src="/images/tile_potensi_baru.jpg" alt="Potensi Desa Citarik" />
	  </div>
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content">
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Beranda</a>
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
        <span class="font-medium text-white">Potensi Desa</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold mt-1.5">Potensi Desa Citarik</h1>
      <p class="text-white/85 mt-1.5 max-w-xl">Sumber daya dan peluang ekonomi yang menanti mitra &amp; pembeli.</p>
    </div>
  </div>
</section>

<div class="container-page py-10 md:py-12 space-y-5">
  {list.length === 0 ? (
    <p class="text-muted text-center py-12">Belum ada potensi yang ditampilkan.</p>
  ) : list.map((p, i) => {
    const cover = covers.get(p.id);
    const imgSrc = cover ? mediaUrl(cover) : (FALLBACK[p.slug] ?? '/images/tile_potensi_baru.jpg');
    return (
    <article class="grid md:grid-cols-2 gap-0 items-stretch card-surface overflow-hidden">
      <a href={`/potensi/${p.slug}`} class:list={['block aspect-[16/11] md:aspect-auto overflow-hidden', i % 2 === 1 && 'md:order-2']}>
        <img src={imgSrc} alt={p.nama}
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
      </a>
      <div class:list={['p-7', i % 2 === 1 && 'md:order-1']}>
        <span class="chip chip-potensi">Potensi</span>
        <h2 class="text-2xl font-heading font-extrabold text-primary mt-2.5">
          <a href={`/potensi/${p.slug}`} class="hover:underline">{p.nama}</a>
        </h2>
        <p class="text-muted leading-relaxed mt-2">{p.ringkasan}</p>
        <a href={`/potensi/${p.slug}`} class="inline-flex items-center gap-1.5 mt-4 text-accent font-heading font-semibold hover:text-primary transition-colors">
          Selengkapnya <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>
    </article>
    );
  })}

  <div class="bg-primary text-white rounded-xl p-8 text-center">
    <h2 class="text-2xl font-heading font-extrabold text-white">Tertarik bermitra dengan Desa Citarik?</h2>
    <p class="text-white/80 mt-2 max-w-xl mx-auto leading-relaxed">Hubungi pemerintah desa untuk informasi investasi, kemitraan, atau kerja sama potensi desa.</p>
    <a href="/kontak" class="btn mt-5 bg-white text-primary hover:bg-sand border border-transparent">
      <i data-lucide="phone" class="w-5 h-5"></i> Hubungi Desa
    </a>
  </div>
</div>

</Layout>
