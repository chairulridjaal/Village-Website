---
import type { FormField, JenisPelayanan } from '../lib/db/pelayanan';
import { DEFAULT_FIELDS } from '../lib/pelayanan/fields-form';

interface Props {
  action: string;
  jenis?: JenisPelayanan | null;
  fields?: FormField[];
}

const { action, jenis = null, fields: fieldsProp } = Astro.props;
const fields = fieldsProp ?? (jenis ? JSON.parse(jenis.fields_json || '[]') as FormField[] : DEFAULT_FIELDS);
const adminFields: FormField[] = jenis
  ? (JSON.parse(jenis.admin_fields_json || '[]') as FormField[])
  : [];
const template = jenis?.template_html || '';
const docxPath = jenis?.template_docx_path ?? '';
const nama = jenis?.nama ?? '';
const deskripsi = jenis?.deskripsi ?? '';
const syarat = jenis?.syarat ?? '';
const aktif = jenis ? !!jenis.aktif : true;
const urutan = jenis?.urutan ?? 0;
const lampiranWajib = jenis ? !!jenis.lampiran_wajib : false;
const lampiranInfo = jenis?.lampiran_info ?? '';
const isNew = !jenis;

const typeLabels: Record<string, string> = {
  text: 'Teks singkat',
  textarea: 'Teks panjang',
  date: 'Tanggal',
  number: 'Angka',
  select: 'Pilihan',
};
---

<form method="POST" action={action} class="space-y-6 max-w-5xl" id="jenis-form">
  <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-950 leading-relaxed">
    <p class="font-heading font-semibold mb-1">Cara template Word (untuk admin non-teknis)</p>
    <ol class="list-decimal pl-5 space-y-1 text-xs sm:text-sm">
      <li>Buat surat di Word seperti biasa (kop, font, spasi tetap).</li>
      <li>
        Isian <strong>warga</strong>: tulis <code class="bg-white px-1 rounded">$$nama$$</code>,
        <code class="bg-white px-1 rounded">$$nik$$</code>,
        <code class="bg-white px-1 rounded">$$alamat$$</code>, dst. (huruf kecil, tanpa spasi).
      </li>
      <li>
        Isian <strong>admin</strong> (setelah terima, sebelum unduh PDF): tulis
        <code class="bg-white px-1 rounded">%%nomor_surat%%</code>,
        <code class="bg-white px-1 rounded">%%tanggal_terbit%%</code>, dst.
      </li>
      <li>Unggah file di bawah → field muncul otomatis → ubah jenis isian bila perlu → Simpan.</li>
    </ol>
    <p class="text-xs mt-2 text-amber-900/90">
      Tip: ketik placeholder utuh sekali (jangan diedit di tengah), agar Word tidak memecah teks.
      Field admin boleh dikosongkan saat unduh PDF (diisi tangan di kertas bila perlu).
    </p>
  </div>

  <div class="bg-white rounded-xl border border-border p-5 space-y-3" style="box-shadow:var(--shadow-sm);">
    <h3 class="font-heading font-semibold text-primary">
      {isNew ? '1. Unggah surat Word (.docx) — wajib untuk cetak 1:1' : '1. Template Word (.docx)'}
    </h3>
    <p class="text-xs text-text-muted leading-relaxed">
      File Word disimpan utuh. Unduhan surat untuk warga memakai file ini (bukan HTML browser).
    </p>
    {docxPath && (
      <p class="text-xs rounded-lg px-3 py-2" style="background:#D1FAE5;color:#065F46;">
        Template Word aktif: <code class="text-[11px]">{docxPath}</code>
      </p>
    )}
    <input type="hidden" id="template_docx_path" name="template_docx_path" value={docxPath} />
    <div class="flex flex-wrap items-center gap-3">
      <input
        type="file"
        id="docx-file"
        accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        class="text-sm max-w-full"
      />
      <button
        type="button"
        id="docx-import-btn"
        class="px-4 py-2 rounded-lg font-heading font-semibold text-sm text-white cursor-pointer"
        style="background:var(--color-primary);min-height:44px;"
      >
        Unggah &amp; impor Word
      </button>
      <span id="docx-import-status" class="text-xs text-text-muted" aria-live="polite"></span>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-border p-5 space-y-4" style="box-shadow:var(--shadow-sm);">
    <h3 class="font-heading font-semibold text-primary">2. Informasi dasar</h3>
    <div>
      <label for="nama" class="block font-heading font-medium text-sm mb-1.5">
        Nama jenis surat <span class="text-cta">*</span>
      </label>
      <input
        type="text"
        id="nama"
        name="nama"
        required
        value={nama}
        class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
        style="border-color:var(--color-border);min-height:44px;"
        placeholder="cth. Surat Keterangan Domisili"
      />
    </div>
    <div>
      <label for="deskripsi" class="block font-heading font-medium text-sm mb-1.5">Deskripsi singkat (katalog)</label>
      <textarea
        id="deskripsi"
        name="deskripsi"
        rows="2"
        class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
        style="border-color:var(--color-border);"
      >{deskripsi}</textarea>
    </div>
    <div>
      <label for="syarat" class="block font-heading font-medium text-sm mb-1.5">Syarat (ditampilkan ke warga)</label>
      <textarea
        id="syarat"
        name="syarat"
        rows="3"
        class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
        style="border-color:var(--color-border);"
        placeholder="cth. KTP asli, fotokopi KK"
      >{syarat}</textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="urutan" class="block font-heading font-medium text-sm mb-1.5">Urutan tampil</label>
        <input
          type="number"
          id="urutan"
          name="urutan"
          value={urutan}
          class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
          style="border-color:var(--color-border);min-height:44px;"
        />
      </div>
      <div class="flex items-end pb-2">
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="aktif" value="1" checked={aktif} class="w-4 h-4" />
          <span class="font-heading font-medium text-sm">Aktif di katalog publik (terbitkan)</span>
        </label>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-border p-5 space-y-4" style="box-shadow:var(--shadow-sm);">
    <h3 class="font-heading font-semibold text-primary">3. Lampiran unggah</h3>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <input type="checkbox" name="lampiran_wajib" value="1" checked={lampiranWajib} class="w-4 h-4" />
      <span class="font-heading font-medium text-sm">Wajib lampiran (KTP/KK dll. di form warga)</span>
    </label>
    <div>
      <label for="lampiran_info" class="block font-heading font-medium text-sm mb-1.5">Petunjuk lampiran</label>
      <textarea
        id="lampiran_info"
        name="lampiran_info"
        rows="2"
        class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
        style="border-color:var(--color-border);"
        placeholder="cth. Unggah fotokopi KTP dan KK (PDF/JPG)."
      >{lampiranInfo}</textarea>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-border p-5 space-y-4" style="box-shadow:var(--shadow-sm);">
    <div class="flex items-center justify-between gap-2">
      <div>
        <h3 class="font-heading font-semibold text-primary">4. Isian warga (dari $$…$$)</h3>
        <p class="text-xs text-text-muted">Otomatis dari Word. Ubah label / jenis isian bila perlu.</p>
      </div>
      <button
        type="button"
        id="add-field"
        class="text-sm font-heading font-semibold px-3 py-1.5 rounded-md border cursor-pointer"
        style="border-color:var(--color-accent);color:var(--color-accent);"
      >
        + Pertanyaan
      </button>
    </div>
    <div id="fields-list" class="space-y-3">
      {fields.map((f) => (
        <div class="field-row grid grid-cols-1 sm:grid-cols-12 gap-2 p-3 rounded-lg border border-border bg-sand/20">
          <input type="hidden" name="field_key" value={f.key} class="field-key-input" />
          <div class="sm:col-span-5">
            <label class="text-xs text-text-muted">Label</label>
            <input
              name="field_label"
              value={f.label}
              required
              class="w-full rounded border px-2 py-2 text-sm field-label-input"
              style="border-color:var(--color-border);"
            />
            <p class="text-[10px] text-text-muted mt-0.5">kode: {f.key}</p>
          </div>
          <div class="sm:col-span-3">
            <label class="text-xs text-text-muted">Jenis isian</label>
            <select name="field_type" class="w-full rounded border px-2 py-2 text-sm" style="border-color:var(--color-border);">
              {Object.entries(typeLabels).map(([t, lbl]) => (
                <option value={t} selected={f.type === t}>{lbl}</option>
              ))}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="text-xs text-text-muted">Opsi (Pilihan)</label>
            <input
              name="field_options"
              value={(f.options ?? []).join('|')}
              class="w-full rounded border px-2 py-2 text-sm"
              style="border-color:var(--color-border);"
              placeholder="A|B|C"
            />
          </div>
          <div class="sm:col-span-2 flex items-end gap-2 pb-1">
            <label class="text-xs flex items-center gap-1">
              <input type="hidden" name="field_required" value={f.required ? '1' : '0'} class="req-hidden" />
              <input type="checkbox" class="req-check" checked={!!f.required} />
              Wajib
            </label>
            <button type="button" class="remove-field text-xs text-red-600 cursor-pointer" title="Hapus">✕</button>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="bg-white rounded-xl border border-border p-5 space-y-4" style="box-shadow:var(--shadow-sm);">
    <div class="flex items-center justify-between gap-2">
      <div>
        <h3 class="font-heading font-semibold text-primary">5. Isian admin (dari %%…%%)</h3>
        <p class="text-xs text-text-muted">
          Diisi setelah pengajuan diterima, sebelum unduh PDF. Boleh dikosongkan (isi tangan di kertas).
        </p>
      </div>
      <button
        type="button"
        id="add-admin-field"
        class="text-sm font-heading font-semibold px-3 py-1.5 rounded-md border cursor-pointer"
        style="border-color:var(--color-accent);color:var(--color-accent);"
      >
        + Field admin
      </button>
    </div>
    <div id="admin-fields-list" class="space-y-3">
      {adminFields.map((f) => (
        <div class="admin-field-row grid grid-cols-1 sm:grid-cols-12 gap-2 p-3 rounded-lg border border-border bg-blue-50/50">
          <input type="hidden" name="admin_field_key" value={f.key} class="admin-field-key-input" />
          <div class="sm:col-span-5">
            <label class="text-xs text-text-muted">Label</label>
            <input
              name="admin_field_label"
              value={f.label}
              class="w-full rounded border px-2 py-2 text-sm admin-field-label-input"
              style="border-color:var(--color-border);"
            />
            <p class="text-[10px] text-text-muted mt-0.5">kode: {f.key}</p>
          </div>
          <div class="sm:col-span-3">
            <label class="text-xs text-text-muted">Jenis isian</label>
            <select name="admin_field_type" class="w-full rounded border px-2 py-2 text-sm" style="border-color:var(--color-border);">
              {Object.entries(typeLabels).map(([t, lbl]) => (
                <option value={t} selected={f.type === t}>{lbl}</option>
              ))}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="text-xs text-text-muted">Opsi</label>
            <input
              name="admin_field_options"
              value={(f.options ?? []).join('|')}
              class="w-full rounded border px-2 py-2 text-sm"
              style="border-color:var(--color-border);"
              placeholder="A|B|C"
            />
          </div>
          <div class="sm:col-span-2 flex items-end gap-2 pb-1">
            <label class="text-xs flex items-center gap-1">
              <input type="hidden" name="admin_field_required" value={f.required ? '1' : '0'} class="admin-req-hidden" />
              <input type="checkbox" class="admin-req-check" checked={!!f.required} />
              Wajib
            </label>
            <button type="button" class="remove-admin-field text-xs text-red-600 cursor-pointer" title="Hapus">✕</button>
          </div>
        </div>
      ))}
    </div>
  </div>

  <input type="hidden" id="template_html" name="template_html" value={template} />

  <div class="hidden" aria-hidden="true">
    <div id="template-editor"></div>
    <div id="template-preview"></div>
    <div id="var-chips"></div>
  </div>

  <div
    class="flex justify-end gap-3 sticky bottom-0 bg-white border-t border-border -mx-4 md:-mx-6 px-4 md:px-6 py-3"
    style="box-shadow:0 -2px 8px rgba(0,0,0,.06);"
  >
    <a
      href="/admin/pelayanan/jenis"
      class="px-4 py-2 rounded-lg font-heading font-medium text-sm border"
      style="border-color:var(--color-border);min-height:44px;display:flex;align-items:center;"
    >
      Batal
    </a>
    <button
      type="submit"
      class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer"
      style="background:var(--color-cta);min-height:44px;"
    >
      {aktif ? 'Simpan & terbitkan' : 'Simpan draf'}
    </button>
  </div>
</form>

<template id="field-row-tpl">
  <div class="field-row grid grid-cols-1 sm:grid-cols-12 gap-2 p-3 rounded-lg border border-border bg-sand/20">
    <input type="hidden" name="field_key" value="" class="field-key-input" />
    <div class="sm:col-span-5">
      <label class="text-xs text-text-muted">Pertanyaan / label</label>
      <input name="field_label" required class="w-full rounded border px-2 py-2 text-sm field-label-input" style="border-color:var(--color-border);" />
    </div>
    <div class="sm:col-span-3">
      <label class="text-xs text-text-muted">Jenis isian</label>
      <select name="field_type" class="w-full rounded border px-2 py-2 text-sm" style="border-color:var(--color-border);">
        <option value="text">Teks singkat</option>
        <option value="textarea">Teks panjang</option>
        <option value="date">Tanggal</option>
        <option value="number">Angka</option>
        <option value="select">Pilihan</option>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label class="text-xs text-text-muted">Opsi (jika Pilihan)</label>
      <input name="field_options" class="w-full rounded border px-2 py-2 text-sm" style="border-color:var(--color-border);" placeholder="A|B|C" />
    </div>
    <div class="sm:col-span-2 flex items-end gap-2 pb-1">
      <label class="text-xs flex items-center gap-1">
        <input type="hidden" name="field_required" value="1" class="req-hidden" />
        <input type="checkbox" class="req-check" checked />
        Wajib
      </label>
      <button type="button" class="remove-field text-xs text-red-600 cursor-pointer" title="Hapus">✕</button>
    </div>
  </div>
</template>

<style>
  .surat-editor img,
  .surat-preview img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
  .surat-editor table,
  .surat-preview table {
    border-collapse: collapse;
    width: 100%;
  }
  .surat-editor p,
  .surat-preview p {
    margin: 0.5rem 0;
  }
  .surat-editor:focus {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    outline-offset: -1px;
  }
</style>

<script>
  const list = document.getElementById('fields-list');
  const tpl = document.getElementById('field-row-tpl') as HTMLTemplateElement | null;
  const form = document.getElementById('jenis-form') as HTMLFormElement | null;
  const docxStatus = document.getElementById('docx-import-status');

  function slugify(label: string): string {
    return (
      label
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_|_$/g, '') || 'field'
    );
  }

  function wireRow(row: Element) {
    const check = row.querySelector('.req-check') as HTMLInputElement | null;
    const reqHidden = row.querySelector('.req-hidden') as HTMLInputElement | null;
    const label = row.querySelector('.field-label-input') as HTMLInputElement | null;
    const keyInput = row.querySelector('.field-key-input') as HTMLInputElement | null;
    check?.addEventListener('change', () => {
      if (reqHidden) reqHidden.value = check.checked ? '1' : '0';
    });
    label?.addEventListener('input', () => {
      if (keyInput && (!keyInput.value || keyInput.dataset.auto !== '0')) {
        keyInput.value = slugify(label.value);
        keyInput.dataset.auto = '1';
      }
    });
    row.querySelector('.remove-field')?.addEventListener('click', () => row.remove());
  }

  list?.querySelectorAll('.field-row').forEach(wireRow);

  document.getElementById('add-field')?.addEventListener('click', () => {
    if (!tpl || !list) return;
    const node = tpl.content.cloneNode(true) as DocumentFragment;
    const row = node.querySelector('.field-row');
    if (row) wireRow(row);
    list.appendChild(node);
  });

  type ImportedField = {
    key: string;
    label: string;
    type: string;
    required?: boolean;
    options?: string[];
  };

  function setInputValue(id: string, value: string) {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    if (el) el.value = value;
  }

  function addFieldRow(field: ImportedField) {
    if (!tpl || !list) return;
    const node = tpl.content.cloneNode(true) as DocumentFragment;
    const row = node.querySelector('.field-row');
    if (!row) return;
    const keyInput = row.querySelector('.field-key-input') as HTMLInputElement | null;
    const labelInput = row.querySelector('.field-label-input') as HTMLInputElement | null;
    const typeSelect = row.querySelector('select[name="field_type"]') as HTMLSelectElement | null;
    const optionsInput = row.querySelector('input[name="field_options"]') as HTMLInputElement | null;
    const reqHidden = row.querySelector('.req-hidden') as HTMLInputElement | null;
    const reqCheck = row.querySelector('.req-check') as HTMLInputElement | null;
    if (keyInput) {
      keyInput.value = field.key;
      keyInput.dataset.auto = '0';
    }
    if (labelInput) labelInput.value = field.label;
    if (typeSelect) typeSelect.value = field.type || 'text';
    if (optionsInput && field.options?.length) optionsInput.value = field.options.join('|');
    const required = field.required !== false;
    if (reqHidden) reqHidden.value = required ? '1' : '0';
    if (reqCheck) reqCheck.checked = required;
    wireRow(row);
    list.appendChild(node);
  }

  const adminList = document.getElementById('admin-fields-list');
  const adminTplHtml = `<div class="admin-field-row grid grid-cols-1 sm:grid-cols-12 gap-2 p-3 rounded-lg border border-border bg-blue-50/50">
    <input type="hidden" name="admin_field_key" value="" class="admin-field-key-input" />
    <div class="sm:col-span-5">
      <label class="text-xs text-text-muted">Label</label>
      <input name="admin_field_label" class="w-full rounded border px-2 py-2 text-sm admin-field-label-input" style="border-color:var(--color-border);" />
    </div>
    <div class="sm:col-span-3">
      <label class="text-xs text-text-muted">Jenis isian</label>
      <select name="admin_field_type" class="w-full rounded border px-2 py-2 text-sm" style="border-color:var(--color-border);">
        <option value="text">Teks singkat</option>
        <option value="textarea">Teks panjang</option>
        <option value="date">Tanggal</option>
        <option value="number">Angka</option>
        <option value="select">Pilihan</option>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label class="text-xs text-text-muted">Opsi</label>
      <input name="admin_field_options" class="w-full rounded border px-2 py-2 text-sm" style="border-color:var(--color-border);" placeholder="A|B|C" />
    </div>
    <div class="sm:col-span-2 flex items-end gap-2 pb-1">
      <label class="text-xs flex items-center gap-1">
        <input type="hidden" name="admin_field_required" value="0" class="admin-req-hidden" />
        <input type="checkbox" class="admin-req-check" />
        Wajib
      </label>
      <button type="button" class="remove-admin-field text-xs text-red-600 cursor-pointer" title="Hapus">✕</button>
    </div>
  </div>`;

  function wireAdminRow(row: Element) {
    const check = row.querySelector('.admin-req-check') as HTMLInputElement | null;
    const reqHidden = row.querySelector('.admin-req-hidden') as HTMLInputElement | null;
    check?.addEventListener('change', () => {
      if (reqHidden) reqHidden.value = check.checked ? '1' : '0';
    });
    row.querySelector('.remove-admin-field')?.addEventListener('click', () => row.remove());
  }

  adminList?.querySelectorAll('.admin-field-row').forEach(wireAdminRow);

  document.getElementById('add-admin-field')?.addEventListener('click', () => {
    if (!adminList) return;
    const wrap = document.createElement('div');
    wrap.innerHTML = adminTplHtml;
    const row = wrap.firstElementChild;
    if (!row) return;
    wireAdminRow(row);
    adminList.appendChild(row);
  });

  function addAdminFieldRow(field: ImportedField) {
    if (!adminList) return;
    const wrap = document.createElement('div');
    wrap.innerHTML = adminTplHtml;
    const row = wrap.firstElementChild;
    if (!row) return;
    const keyInput = row.querySelector('.admin-field-key-input') as HTMLInputElement | null;
    const labelInput = row.querySelector('.admin-field-label-input') as HTMLInputElement | null;
    const typeSelect = row.querySelector('select[name="admin_field_type"]') as HTMLSelectElement | null;
    const optionsInput = row.querySelector('input[name="admin_field_options"]') as HTMLInputElement | null;
    const reqHidden = row.querySelector('.admin-req-hidden') as HTMLInputElement | null;
    const reqCheck = row.querySelector('.admin-req-check') as HTMLInputElement | null;
    if (keyInput) keyInput.value = field.key;
    if (labelInput) labelInput.value = field.label;
    if (typeSelect) typeSelect.value = field.type || 'text';
    if (optionsInput && field.options?.length) optionsInput.value = field.options.join('|');
    const required = !!field.required;
    if (reqHidden) reqHidden.value = required ? '1' : '0';
    if (reqCheck) reqCheck.checked = required;
    wireAdminRow(row);
    adminList.appendChild(row);
  }

  function applyImport(data: {
    nama?: string;
    deskripsi?: string;
    syarat?: string;
    fields?: ImportedField[];
    admin_fields?: ImportedField[];
    template_html?: string;
    template_docx_path?: string;
    warnings?: string[];
  }) {
    if (data.nama) setInputValue('nama', data.nama);
    if (data.deskripsi != null) setInputValue('deskripsi', data.deskripsi);
    if (data.syarat != null) setInputValue('syarat', data.syarat);
    if (data.template_docx_path) {
      const pathInput = document.getElementById('template_docx_path') as HTMLInputElement | null;
      if (pathInput) pathInput.value = data.template_docx_path;
    }
    if (Array.isArray(data.fields) && list) {
      list.innerHTML = '';
      data.fields.forEach(addFieldRow);
    }
    if (Array.isArray(data.admin_fields) && adminList) {
      adminList.innerHTML = '';
      data.admin_fields.forEach(addAdminFieldRow);
    }
    if (Array.isArray(data.warnings) && data.warnings.length && docxStatus) {
      docxStatus.textContent = data.warnings.join(' ');
    }
  }

  const docxBtn = document.getElementById('docx-import-btn');
  const docxFile = document.getElementById('docx-file') as HTMLInputElement | null;

  async function runImport(file: File) {
    if (!docxBtn) return;
    if (docxStatus) docxStatus.textContent = 'Mengunggah & mengimpor…';
    docxBtn.setAttribute('disabled', 'true');
    try {
      const body = new FormData();
      body.append('docx', file);
      const namaEl = document.getElementById('nama') as HTMLInputElement | null;
      if (namaEl?.value) body.append('nama', namaEl.value);
      const res = await fetch('/api/admin/pelayanan/jenis/upload-docx', {
        method: 'POST',
        body,
        credentials: 'same-origin',
      });
      const data = await res.json();
      if (!res.ok || !data?.ok) {
        throw new Error(data?.message || data?.error || 'Gagal mengunggah.');
      }
      applyImport(data);
      if (docxStatus) {
        docxStatus.textContent = data.template_docx_path
          ? `Template Word tersimpan. Periksa form, lalu simpan jenis surat.`
          : 'Impor selesai. Simpan jenis surat.';
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Gagal mengunggah.';
      if (docxStatus) docxStatus.textContent = msg;
    } finally {
      docxBtn.removeAttribute('disabled');
    }
  }

  docxBtn?.addEventListener('click', async () => {
    const file = docxFile?.files?.[0];
    if (!file) {
      if (docxStatus) docxStatus.textContent = 'Pilih file .docx dulu.';
      return;
    }
    await runImport(file);
  });

  docxFile?.addEventListener('change', () => {
    const file = docxFile.files?.[0];
    if (file && docxStatus) docxStatus.textContent = `File: ${file.name} — klik “Unggah & impor Word”.`;
  });
</script>
