---
import '../styles/global.css';
import { hasPerm, isMaster, type PermFlag } from '../lib/auth/permissions';

interface Props {
  title: string;
  breadcrumb?: string;
  currentPath?: string;
}

const { title, breadcrumb, currentPath = Astro.url.pathname } = Astro.props;


const user = Astro.locals.user;

type MenuItem = { href: string; label: string; perm?: PermFlag | 'master' };
type MenuGroup = { id: string; title: string; items: MenuItem[] };

const menuGroups: MenuGroup[] = [
  {
    id: 'utama',
    title: 'Utama',
    items: [{ href: '/admin/dasbor', label: 'Dasbor' }],
  },
  {
    id: 'konten',
    title: 'Konten',
    items: [
      { href: '/admin/konten', label: 'Halaman', perm: 'perm_konten' },
      { href: '/admin/statistik-desa', label: 'Statistik Desa', perm: 'perm_konten' },
      { href: '/admin/perangkat', label: 'Perangkat Desa', perm: 'perm_konten' },
      { href: '/admin/menu', label: 'Menu situs', perm: 'perm_konten' },
      { href: '/admin/potensi', label: 'Potensi', perm: 'perm_konten' },
    ],
  },
  {
    id: 'layanan',
    title: 'Layanan',
    items: [{ href: '/admin/pelayanan', label: 'Pelayanan', perm: 'perm_pelayanan' }],
  },
  {
    id: 'direktori',
    title: 'Direktori',
    items: [
      { href: '/admin/umkm', label: 'UMKM', perm: 'perm_umkm' },
      { href: '/admin/berita', label: 'Berita', perm: 'perm_berita' },
      { href: '/admin/pengumuman', label: 'Banner pengumuman', perm: 'perm_berita' },
      { href: '/admin/peta', label: 'Peta', perm: 'perm_peta' },
      { href: '/admin/media', label: 'Media', perm: 'perm_media' },
    ],
  },
  {
    id: 'sistem',
    title: 'Sistem',
    items: [
      { href: '/admin/pengaturan', label: 'Pengaturan', perm: 'perm_pengaturan' },
      { href: '/admin/akun', label: 'Akun admin', perm: 'master' },
      { href: '/admin/statistik', label: 'Kunjungan & Backup' },
    ],
  },
];

function canSee(item: MenuItem): boolean {
  if (!item.perm) return true;
  if (item.perm === 'master') return isMaster(user);
  return hasPerm(user, item.perm);
}

const isActive = (href: string) =>
  href === '/admin/dasbor'
    ? currentPath === href || currentPath === '/admin'
    : currentPath.startsWith(href);

const visibleGroups = menuGroups
  .map((g) => ({ ...g, items: g.items.filter(canSee) }))
  .filter((g) => g.items.length > 0);

type NavBlock =
  | { kind: 'flat'; item: MenuItem }
  | { kind: 'group'; id: string; title: string; items: MenuItem[]; defaultOpen: boolean };

const navBlocks: NavBlock[] = visibleGroups.map((g) => {
  if (g.items.length === 1) return { kind: 'flat' as const, item: g.items[0] };
  return {
    kind: 'group' as const,
    id: g.id,
    title: g.title,
    items: g.items,
    defaultOpen: g.items.some((i) => isActive(i.href)),
  };
});
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{title} | Panel Admin Desa Citarik</title>
  <meta name="robots" content="noindex,nofollow" />
</head>

<body class="font-body min-h-screen" style="background:#F1F5F9; color:var(--color-text);">

  <!-- ── Sidebar (desktop) ──────────────────────────────── -->
  <aside
    id="admin-sidebar"
    class="fixed top-0 left-0 h-full w-64 z-30 flex flex-col"
    style="background:#0A3650; transform:translateX(-100%); transition:transform 200ms ease;"
    aria-label="Sidebar admin"
  >
    <!-- Logo -->
    <a href="/admin/dasbor" class="flex items-center gap-3 px-5 py-5 border-b border-white/10 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent">
      <span class="w-9 h-9 rounded-full bg-accent grid place-items-center font-heading font-bold text-sm text-white shrink-0" aria-hidden="true">DC</span>
      <div class="leading-tight">
        <span class="block font-heading font-bold text-white text-sm">Panel Admin</span>
        <span class="block text-white/60 text-xs">Desa Citarik</span>
      </div>
    </a>

    <!-- Menu -->
    <nav aria-label="Menu admin" class="flex flex-col p-3 gap-1 flex-1 overflow-y-auto">
      {navBlocks.map((block) => {
        if (block.kind === 'flat') {
          const { href, label } = block.item;
          const active = isActive(href);
          return (
            <a
              href={href}
              class:list={[
                'flex items-center gap-3 px-3 py-2.5 rounded-md font-heading font-medium text-sm transition-colors duration-150 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent',
                active ? 'bg-accent text-white' : 'text-white/75 hover:bg-white/10 hover:text-white',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {label}
            </a>
          );
        }
        const open = block.defaultOpen;
        return (
          <div class="admin-nav-group" data-group-id={block.id} data-open={open ? '1' : '0'}>
            <button
              type="button"
              class="admin-nav-toggle w-full flex items-center justify-between gap-2 px-3 py-2 rounded-md text-left cursor-pointer hover:bg-white/10 transition-colors focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent"
              aria-expanded={open ? 'true' : 'false'}
              data-group-toggle
            >
              <span class="text-[11px] font-heading font-semibold uppercase tracking-wider text-white/55">{block.title}</span>
              <svg
                class="admin-nav-chevron w-3.5 h-3.5 text-white/50 shrink-0 transition-transform duration-200"
                style={open ? 'transform:rotate(0deg)' : 'transform:rotate(-90deg)'}
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div
              class="admin-nav-panel flex flex-col gap-0.5 pl-1 border-l border-white/10 ml-3 mt-0.5 overflow-hidden"
              data-group-panel
              hidden={!open}
            >
              {block.items.map(({ href, label }) => {
                const active = isActive(href);
                return (
                  <a
                    href={href}
                    class:list={[
                      'flex items-center gap-2 pl-3 pr-3 py-2 rounded-md font-heading font-medium text-sm transition-colors duration-150 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent',
                      active ? 'bg-accent text-white' : 'text-white/75 hover:bg-white/10 hover:text-white',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {label}
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </nav>

    <!-- Keluar -->
    <div class="p-3 border-t border-white/10">
      <form method="POST" action="/api/admin/logout">
        <button
          type="submit"
          class="w-full flex items-center gap-3 px-3 py-2.5 rounded-md font-heading font-medium text-sm text-white/75 hover:bg-white/10 hover:text-white transition-colors duration-150 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent cursor-pointer"
        >
          Keluar
        </button>
      </form>
    </div>
  </aside>

  <!-- ── Backdrop overlay (mobile) ──────────────────────── -->
  <div id="admin-overlay" class="fixed inset-0 bg-black/40 z-20 hidden lg:hidden" aria-hidden="true"></div>

  <!-- ── Main content area ──────────────────────────────── -->
  <div class="lg:pl-64 min-h-screen flex flex-col">

    <!-- Top bar -->
    <header class="sticky top-0 z-10 bg-white border-b border-border flex items-center justify-between px-4 md:px-6 h-14 shrink-0" style="box-shadow:var(--shadow-sm);">
      <div class="flex items-center gap-3">
        <!-- Hamburger (mobile) -->
        <button
          id="admin-hamburger"
          class="lg:hidden w-10 h-10 rounded-md flex items-center justify-center hover:bg-sand transition-colors cursor-pointer focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent"
          aria-label="Buka menu"
          aria-expanded="false"
          aria-controls="admin-sidebar"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <!-- Breadcrumb -->
        <span class="font-heading font-semibold text-primary text-sm md:text-base">
          {breadcrumb ?? title}
        </span>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/"
          target="_blank"
          rel="noopener"
          class="text-sm font-heading font-medium text-accent hover:underline focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent rounded px-1"
        >
          Lihat Situs ↗
        </a>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1 p-4 md:p-6">
      <slot />
    </main>

  </div>

</body>

<style>
  @media (min-width: 1024px) {
    #admin-sidebar {
      transform: translateX(0) !important;
    }
  }
  #admin-sidebar.sidebar-open {
    transform: translateX(0) !important;
  }
</style>

<script>
  const sidebar = document.getElementById('admin-sidebar');
  const overlay = document.getElementById('admin-overlay');
  const hamburger = document.getElementById('admin-hamburger');
  const STORAGE_KEY = 'admin-nav-collapsed';

  function openSidebar() {
    sidebar?.classList.add('sidebar-open');
    overlay?.classList.remove('hidden');
    hamburger?.setAttribute('aria-expanded', 'true');
  }
  function closeSidebar() {
    sidebar?.classList.remove('sidebar-open');
    overlay?.classList.add('hidden');
    hamburger?.setAttribute('aria-expanded', 'false');
  }

  hamburger?.addEventListener('click', openSidebar);
  overlay?.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSidebar(); });

  function loadCollapsed() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}'); }
    catch { return {}; }
  }
  function saveCollapsed(map) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(map));
  }

  const collapsedMap = loadCollapsed();

  document.querySelectorAll('.admin-nav-group').forEach((group) => {
    const id = group.dataset.groupId ?? '';
    const toggle = group.querySelector('[data-group-toggle]');
    const panel = group.querySelector('[data-group-panel]');
    const chevron = group.querySelector('.admin-nav-chevron');
    if (!toggle || !panel) return;

    const hasActive = group.querySelector('[aria-current="page"]');
    let open = group.dataset.open === '1';
    if (!hasActive && id in collapsedMap) open = !collapsedMap[id];

    function applyOpen(isOpen) {
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      panel.hidden = !isOpen;
      if (chevron) chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(-90deg)';
      group.dataset.open = isOpen ? '1' : '0';
    }
    applyOpen(open);

    toggle.addEventListener('click', () => {
      open = !open;
      applyOpen(open);
      collapsedMap[id] = !open;
      saveCollapsed(collapsedMap);
    });
  });
</script>
</html>
