---
import '../styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION, GOOGLE_SITE_VERIFICATION } from '@lib/site';
import { getPengaturan } from '../lib/db/pengaturan';
import { getActivePengumumanForHomepage } from '../lib/db/pengumuman';
import { getEnv } from '@lib/env';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  transparentNav?: boolean;
  /** JSON-LD tambahan per halaman (mis. NewsArticle di detail berita) */
  jsonLd?: Record<string, unknown>;
  /** Banner pengumuman di atas nav (hanya beranda) */
  showAnnouncement?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage,
  transparentNav = false,
  jsonLd,
  showAnnouncement = false,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage ?? '/images/pemandangan_citarik.png', site).href;
const currentPath = Astro.url.pathname;

const env = getEnv();
const s = env ? await getPengaturan(env.DB).catch(() => ({} as Record<string, string>)) : {};
const kecamatan = s.kecamatan || 'Palabuhanratu';
const kabupaten = s.kabupaten || 'Sukabumi';
const email = s.kontak_email || 'desacitarik@gmail.com';
const street = s.kontak_alamat || 'Kantor Desa Citarik, Kecamatan Palabuhanratu, Kabupaten Sukabumi';

const announcement =
  showAnnouncement && env
    ? await getActivePengumumanForHomepage(env.DB).catch(() => null)
    : null;

const announceStyle: Record<string, string> = {
  info: 'background:#0E4A6E;color:#fff',
  success: 'background:#15803D;color:#fff',
  warning: 'background:#B45309;color:#fff',
  urgent: 'background:#B91C1C;color:#fff',
};

// Data organisasi untuk mesin pencari (schema.org)
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  name: `Pemerintah ${SITE_NAME}`,
  alternateName: ['Desa Citarik', `Desa Citarik ${kabupaten}`, `Desa Citarik ${kecamatan}`],
  url: SITE_URL,
  email,
  logo: new URL('/favicon.svg', site).href,
  areaServed: `Desa Citarik, Kecamatan ${kecamatan}, Kabupaten ${kabupaten}, Jawa Barat`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: street,
    addressLocality: kecamatan,
    addressRegion: 'Jawa Barat',
    addressCountry: 'ID',
  },
};

// Skema WebSite — memperkuat "Desa Citarik" sebagai nama situs di hasil pencarian.
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: 'Situs Resmi Desa Citarik',
  url: SITE_URL,
  inLanguage: 'id-ID',
  publisher: { '@type': 'GovernmentOrganization', name: `Pemerintah ${SITE_NAME}` },
};
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <!-- Favicon (untuk logo di hasil pencarian Google & tab browser) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E4A6E" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Lucide icons (pinned version for stability) -->
    <script src="https://unpkg.com/lucide@0.469.0" defer></script>
    {/* Cloudflare Web Analytics — aktifkan dengan mengganti token lalu buka comment:
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "REPLACE_WITH_CF_ANALYTICS_TOKEN"}'></script>
    */}
  </head>

  <body class="bg-bg text-text font-body min-h-dvh">

    <!-- Skip to main content (first focusable element) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:outline-none"
    >
      Lewati ke konten utama
    </a>

    <div id="site-chrome" class="fixed top-0 inset-x-0 z-50">
      {announcement && (
        <div
          id="site-announcement"
          class="text-sm"
          style={announceStyle[announcement.style] || announceStyle.info}
          role="region"
          aria-label="Pengumuman desa"
        >
          <div class="container-page py-2.5 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
            <div class="flex items-start gap-2 flex-1 min-w-0">
              <i data-lucide="megaphone" class="w-4 h-4 mt-0.5 shrink-0 opacity-90"></i>
              <p class="leading-snug font-medium">{announcement.teks}</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              {announcement.tautan_url && (
                <a
                  href={announcement.tautan_url}
                  class="font-heading font-semibold underline underline-offset-2 hover:opacity-90 whitespace-nowrap"
                >
                  {announcement.tautan_label || 'Selengkapnya'}
                </a>
              )}
              <button
                type="button"
                id="announce-dismiss"
                class="w-8 h-8 rounded-md flex items-center justify-center hover:bg-white/15 cursor-pointer"
                aria-label="Tutup pengumuman"
              >
                <i data-lucide="x" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </div>
      )}
      <Nav transparent={transparentNav} currentPath={currentPath} embedded={true} />
    </div>

    <script is:inline>
      (function () {
        var chrome = document.getElementById('site-chrome');
        var bar = document.getElementById('site-announcement');
        var btn = document.getElementById('announce-dismiss');
        var main = document.getElementById('main-content');
        var transparent = main && main.dataset.transparentNav === '1';

        function setChromePad() {
          if (!chrome) return;
          var h = Math.ceil(chrome.getBoundingClientRect().height) || 80;
          document.documentElement.style.setProperty('--site-chrome-h', h + 'px');
          if (main && !transparent) {
            main.style.paddingTop = h + 'px';
          }
        }

        if (bar && btn) {
          var key = 'citarik-announce-dismiss-' + (bar.textContent || '').slice(0, 80);
          try {
            if (sessionStorage.getItem(key) === '1') {
              bar.style.display = 'none';
            }
          } catch (e) {}
          btn.addEventListener('click', function () {
            bar.style.display = 'none';
            try { sessionStorage.setItem(key, '1'); } catch (e) {}
            setChromePad();
          });
        }

        setChromePad();
        window.addEventListener('resize', setChromePad, { passive: true });
        window.addEventListener('scroll', setChromePad, { passive: true });
        setTimeout(setChromePad, 0);
        setTimeout(setChromePad, 100);
      })();
    </script>

    <!-- Main content (single landmark — pages must not nest another <main>) -->
    <main
      id="main-content"
      data-transparent-nav={transparentNav ? '1' : '0'}
      class={transparentNav ? '' : undefined}
      style={transparentNav
        ? 'scroll-padding-top: var(--site-chrome-h, 80px);'
        : 'padding-top: var(--site-chrome-h, 80px);'}
    >
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <script is:inline>
      function initLucideIcons() {
        if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
          lucide.createIcons();
        }
      }
      document.addEventListener('DOMContentLoaded', initLucideIcons);
      // Fallback for late-loaded CDN script
      window.addEventListener('load', initLucideIcons);
      setTimeout(initLucideIcons, 400);
      // Expose for dynamic page scripts (UMKM filter, etc.)
      window.refreshIcons = initLucideIcons;
    </script>
  </body>
</html>
