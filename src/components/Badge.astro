---
interface Props {
  type: 'umkm' | 'potensi' | 'kuliner' | 'kriya' | 'jasa' | 'tani';
  class?: string;
  label?: string;
}

const { type, class: className, label } = Astro.props;

const labels: Record<string, string> = {
  umkm: 'UMKM',
  potensi: 'Potensi',
  kuliner: 'Kuliner',
  kriya: 'Kriya',
  jasa: 'Jasa',
  tani: 'Hasil Tani',
};

const chipClass: Record<string, string> = {
  umkm: 'chip chip-umkm',
  potensi: 'chip chip-potensi',
  kuliner: 'chip chip-kuliner',
  kriya: 'chip chip-kriya',
  jasa: 'chip chip-jasa',
  tani: 'chip chip-tani',
};
---

<span class:list={[chipClass[type] ?? 'chip chip-potensi', className]}>
  {label ?? labels[type]}
</span>
